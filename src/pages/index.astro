---
// The whole site is this one page (PRD §3). Sections carry ids and the nav
// links to them.
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SkillTree from "../components/SkillTree.astro";
import SkillConstellation from "../components/SkillConstellation.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
---

<BaseLayout
  title="Sai Rishi Ventrapragada — Building for the web"
  description="Portfolio of Sai Rishi Ventrapragada, CSE (Data Science) student at VJIT building with React, Astro and Supabase."
>
  {/* Perforated seams at every top-level boundary (PRD §5.12) but one:
      Skills→Video editing has none (owner's call, increment 24), so the two
      skill sections meet directly. The fifth, Projects→Contact, is at the
      top of Footer.astro: the footer is rendered by the layout, outside
      this slot.

      About and Projects are light (§5.16), so the three seams that touch
      them are told which side is which: each half punches its own section's
      surface, and the stock stays the lighter of the two so the strip reads
      as film over both. --light-* are the scoped values, named in
      styles/theme-light.css. */}
  <Hero />
  <Divider below="var(--light-bg)" stock="var(--light-stock)" />
  <About />
  <Divider above="var(--light-bg)" stock="var(--light-stock)" />
  <SkillTree />
  <SkillConstellation />
  <Divider />
  <ExperienceTimeline />
  <Divider below="var(--light-bg)" stock="var(--light-stock)" />
  <ProjectsSection />
</BaseLayout>
