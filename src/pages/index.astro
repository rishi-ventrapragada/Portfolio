---
// The whole site is this one page (PRD §3). Sections carry ids and the nav
// links to them.
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import EdgeCode from "../components/EdgeCode.astro";
import LoopDivider from "../components/LoopDivider.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SkillTree from "../components/SkillTree.astro";
import SkillConstellation from "../components/SkillConstellation.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
---

<BaseLayout
  title="Sai Rishi Ventrapragada — Building for the web"
  description="Portfolio of Sai Rishi Ventrapragada, CSE (Data Science) student at VJIT building with React, Astro and Supabase."
>
  {/* Seams (PRD §5.12). Hero→About keeps the film perforation, told which
      side is light (§5.16) so each half punches its own section's surface.
      About→Skills is a strip of film edge code (EdgeCode.astro, increment
      29) and Experience→Projects a clapperboard (LoopDivider.astro). Skills→Video editing
      and Video editing→Experience have none (owner's calls, increments 24
      and 25). Projects→Contact, the countdown leader, is at the top of
      Footer.astro: the footer is rendered by the layout, outside this
      slot. */}
  <Hero />
  <Divider below="var(--light-bg)" stock="var(--light-stock)" />
  <About />
  <EdgeCode />
  <SkillTree />
  <SkillConstellation />
  <ExperienceTimeline />
  <LoopDivider variant="clapper" />
  <ProjectsSection />
</BaseLayout>
