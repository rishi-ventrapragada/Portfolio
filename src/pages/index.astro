---
// The whole site is this one page (PRD §3). Sections carry ids and the nav
// links to them.
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import EdgeCode from "../components/EdgeCode.astro";
import ClapperStrip from "../components/ClapperStrip.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import SkillsSection from "../components/SkillsSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import { heroPreload, heroSizes } from "../lib/hero-image";
---

<BaseLayout
  title="Sai Rishi Ventrapragada — Building for the web"
  description="Portfolio of Sai Rishi Ventrapragada, CSE (Data Science) student at VJIT building with React, Astro and Supabase."
>
  {/* The LCP element (PRD §8, increment 32): requested from the head at high
      priority, the same renditions Hero.astro's <Image> picks from. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroSizes}
    fetchpriority="high"
  />
  {/* Seams (PRD §5.12). Hero→About keeps the film perforation, told which
      side is light (§5.16) so each half punches its own section's surface.
      About→Skills is a strip of film edge code (EdgeCode.astro, increment
      29) and Experience→Projects clapperboard sticks (ClapperStrip.astro,
      increment 30). Skills→Experience has none (owner's call, increment
      25; since increment 31 Skills is one section, the old Skills→Video
      editing boundary is gone). Projects→Contact, the countdown leader, is at the top of
      Footer.astro: the footer is rendered by the layout, outside this
      slot. */}
  <Hero />
  <Divider below="var(--light-bg)" stock="var(--light-stock)" />
  <About />
  <EdgeCode />
  <SkillsSection />
  <ExperienceTimeline />
  <ClapperStrip />
  <ProjectsSection />
</BaseLayout>
