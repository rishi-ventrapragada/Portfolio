---
// Case study page (PRD §5.5). Routing and layout land in increment 2 so
// increment 3 only has to write the prose.
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import CaseStudyMeta from "../../components/CaseStudyMeta.astro";
import CaseStudyToc from "../../components/CaseStudyToc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
// Content Layer API: top-level render(), not the removed entry.render().
const { Content, headings } = await render(entry);
const { title, summary, role, stack, status, year, links, cover } = entry.data;
---

<BaseLayout title={`${title} — Sai Rishi Ventrapragada`} description={summary}>
  <article class="case shell">
    <p class="label eyebrow">{status} &middot; {year}</p>
    <h1 class="title">{title}</h1>
    <p class="summary">{summary}</p>

    <Image
      class="cover"
      src={cover}
      alt={`${title} project cover`}
      widths={[592, 1184]}
      sizes="(min-width: 768px) 1184px, 92vw"
      loading="eager"
      decoding="async"
    />

    <div class="layout">
      <aside class="sidebar">
        <CaseStudyMeta role={role} stack={stack} links={links} />

        <CaseStudyToc headings={headings} />
      </aside>

      <div class="body">
        <Content />
      </div>
    </div>

    <p class="back"><a class="label" href="/#projects-heading">&larr; All work</a></p>
  </article>
</BaseLayout>

<style>
  .case {
    padding-block: var(--rhythm);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .title {
    margin: 0 0 1rem;
    font-size: var(--size-h1);
  }

  .summary {
    margin: 0 0 2.5rem;
    max-width: 60ch;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--fg);
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  /* --- Two columns on desktop (PRD §5.5) -------------------------------
     The sidebar is second in the DOM so reading and tab order stay
     content-first; grid places it in the right-hand column at >=1024px. */
  .layout {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 4rem;
      align-items: start;
    }

    .sidebar {
      position: sticky;
      top: 2rem;
      order: 2;
    }
  }

  .sidebar {
    display: grid;
    gap: 2rem;
    align-content: start;
  }

  /* --- MDX prose ---------------------------------------------------------
     The case study body is rendered from MDX, so its elements carry no
     classes; they are styled here with :global. scroll-margin-top keeps a
     heading clear of the viewport edge when reached from a TOC anchor. */
  .body {
    max-width: 68ch;
  }

  .body :global(h2) {
    margin-block: 3rem 1rem;
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    scroll-margin-top: 2rem;
  }

  .body :global(h2:first-child) {
    margin-block-start: 0;
  }

  .body :global(p) {
    margin-block: 0 1.25rem;
    color: var(--fg);
  }

  .body :global(p:last-child) {
    margin-block-end: 0;
  }

  /* Lead-ins like "**No cart, on purpose.**" open a paragraph, so they take
     the heading colour to register as sub-points rather than stray bold. */
  .body :global(strong) {
    color: var(--heading);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  .back {
    margin: 0;
  }

  .back a {
    color: var(--accent);
  }
</style>
