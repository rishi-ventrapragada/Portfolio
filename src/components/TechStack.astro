---
// Tech stack (PRD §5.6): six category cards of plain tag pills. A showcase,
// not a "shipped with" list, so nothing in this section links anywhere.
// Category order and items are the owner's, verbatim.
import Pills from "./Pills.astro";

const categories = [
  {
    name: "Languages",
    items: ["C", "Python", "Java", "HTML", "CSS", "JavaScript", "TypeScript", "Dart"],
  },
  {
    name: "Frameworks",
    items: ["Flutter", "Astro", "React", "Next.js", "Node.js", "Django", "FastAPI", "Tailwind CSS", "Vite"],
  },
  {
    name: "AI",
    items: ["Claude", "Claude Code", "Gemini", "GPT-6 Astra", "Codex", "Ollama", "Open Router"],
  },
  { name: "Tools", items: ["Notion", "Canva", "Figma"] },
  { name: "Platforms", items: ["Supabase", "Firebase", "Vercel", "Render"] },
  { name: "Cloud", items: ["Google Cloud", "AWS"] },
];

const learning = ["Docker", "Kubernetes"];
---

<section class="stack shell" id="skills" aria-labelledby="skills-heading">
  <p class="label eyebrow">Toolkit</p>
  <h2 id="skills-heading" class="heading">Tech stack</h2>

  <div class="grid">
    {
      categories.map((category) => (
        <article class="category">
          <h3 class="label name">{category.name}</h3>
          <Pills items={category.items} label={category.name} />
        </article>
      ))
    }
  </div>

  <div class="learning">
    <p class="meta learning-label">Currently learning</p>
    <Pills items={learning} muted label="Currently learning" />
  </div>
</section>

<style>
  .stack {
    padding-block: var(--rhythm);
    border-top: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .heading {
    margin: 0 0 2rem;
    font-size: var(--size-h2);
  }

  /* Six cards balance as three across on desktop, two on a tablet, one on a
     phone. A 20rem floor gets there with auto-fit and no breakpoints: four
     columns would need 1328px, more than the 1184px shell. */
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .category {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.25rem;
    background-color: var(--bg-raised);
    border: 1px solid var(--line);
  }

  .name {
    margin: 0;
    color: var(--accent);
  }

  .learning {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .learning-label {
    margin: 0;
  }
</style>
