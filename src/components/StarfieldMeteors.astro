---
// The meteors of Starfield.astro (PRD §5.14), split out for the CLAUDE.md §5
// line cap. Geometry is Recurzn-Web's own (increment 23): a full-width track
// at a static angle, a 2px streak with a bright head, 9 / 11 / 13s periods.
// Rendered inside the sky's .sky box, so it inherits its clip and containment.
import { meteors } from "../lib/starfield-data";
---

<div class="meteors">
  {
    meteors.map((m) => (
      <span class="meteor-track" style={`top: ${m.top}%; left: ${m.left}%; width: ${m.length}vw; --angle: ${m.angle}deg`}>
        <span class="meteor" style={`--dur: ${m.duration}s; --delay: ${m.delay}s`} />
      </span>
    ))
  }
</div>

<style>
  .meteors {
    position: absolute;
    inset: 0;
  }

  /* The track holds a STATIC rotation and the streak inside it animates
     translateX only, so the angle is never part of the animation and a
     resize cannot make a meteor jump mid-flight. The streak is the full
     track width, and translate percentages resolve against its own box, so
     -100% → 100% is exactly one track length. */
  .meteor-track {
    position: absolute;
    height: 2px;
    transform: rotate(var(--angle));
    transform-origin: 0 50%;
  }

  /* Faint tail, bright head, round cap: monochrome --heading throughout
     (PRD §5.14). The glow is a static drop shadow — nothing per frame. */
  .meteor {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--heading) 35%, transparent) 55%,
      color-mix(in srgb, var(--heading) 90%, transparent) 92%,
      var(--heading) 100%
    );
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--heading) 70%, transparent));
    opacity: 0;
    animation: meteor var(--dur) linear var(--delay) infinite;
    will-change: transform, opacity;
  }

  /* Travel and fade finish inside the same 18% window: it crosses while
     visible, then parks off-screen for the other ~82%. Linear — a meteor
     that decelerates reads as wrong. */
  @keyframes meteor {
    0% {
      transform: translateX(-100%);
      opacity: 0;
    }
    3% {
      opacity: 1;
    }
    15% {
      opacity: 1;
    }
    18% {
      transform: translateX(100%);
      opacity: 0;
    }
    100% {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  /* Reduced motion: half speed and dimmed, never removed (the reasoning is in
     Starfield.astro). The dim goes on the track, not the streak: the
     keyframes own the streak's opacity, so a plain opacity there would be
     overridden by the running animation. */
  @media (prefers-reduced-motion: reduce) {
    .meteor {
      animation-duration: calc(var(--dur) * 2);
    }

    .meteor-track {
      opacity: 0.35;
    }
  }
</style>
