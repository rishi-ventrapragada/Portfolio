---
// Skills (PRD §5.6, increment 31): one section, one graph. Replaces the
// skill tree and the video-editing constellation — two sections in two
// visual languages — with a single Obsidian-style map of every skill, on
// the section's sky. From 960px the graph (SkillsGraph.astro) is what you
// see and the list (SkillsList.astro) is what a screen reader and the
// keyboard use; below 960px, and without JavaScript, the list is the
// layout. Content is the owner's, verbatim (lib/skills-data.ts).
import SkillsGraph from "./SkillsGraph.astro";
import SkillsList from "./SkillsList.astro";
import Starfield from "./Starfield.astro";
---

<section class="skills shell" id="skills" aria-labelledby="skills-heading" data-skills>
  {/* Without JS nothing moves the graph or routes the keyboard through it,
      so the stacked list is the layout at every width. */}
  <noscript>
    <style>
      [data-skills-graph] { display: none !important; }
      [data-skills-list] { position: static !important; width: auto !important; height: auto !important; overflow: visible !important; clip-path: none !important; white-space: normal !important; }
    </style>
  </noscript>

  <Starfield variant={1} meteors={false} />

  <p class="label eyebrow halo">Toolkit</p>
  {/* The hint (increment 32) is the keyboard route's instructions: the
      tree's description (skills-keys.ts), and on screen from 960px while
      the route has focus — nothing else says the arrows work. */}
  <div class="title">
    <h2 id="skills-heading" class="heading halo">Skills</h2>
    <p class="meta hint halo" id="skills-hint">Arrow keys move between skills · Home / End jump to the ends</p>
  </div>

  <div class="body">
    <SkillsGraph />
    <SkillsList />
  </div>
</section>

<script>
  import { initSkillsGraph } from "../scripts/skills-graph";

  const root = document.querySelector<HTMLElement>("[data-skills]");
  if (root) initSkillsGraph(root);
</script>

<style>
  /* Positioned so the Starfield bounds itself to this section, and the
     content lifted above it. */
  .skills {
    position: relative;
    padding-block: var(--rhythm);
  }

  .eyebrow,
  .title,
  .body {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin: 0 0 2rem;
  }

  .heading {
    margin: 0;
    font-size: var(--size-h2);
  }

  /* Below 960px the list is plain markup and there is no route; from 960px
     the hint keeps its place (visibility, so nothing shifts) and shows
     while focus is in the list. */
  .hint {
    display: none;
    margin: 0;
  }

  @media (min-width: 960px) {
    .hint {
      display: block;
      visibility: hidden;
    }

    .skills:has(.body:focus-within) .hint {
      visibility: visible;
    }
  }
</style>
