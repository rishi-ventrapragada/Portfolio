---
// The credits block of the footer sequence (PRD §5.8, increment 23). Lines
// accumulate: each appears as its scroll zone is reached and then stays, so
// the block builds up into one assembled piece of text rather than one line
// replacing another. Every line is laid out from the start (hidden with
// opacity), so the block is already its final size and centred — a line
// arriving never pushes the others around. scripts/footer-scrub.ts sets
// data-shown; none is shown from the server (the first stage is blank,
// increment 30). The last line is the name, in --heading and larger; the
// rest are accent.
interface Props {
  lines: readonly string[];
}

const { lines } = Astro.props;
---

<div class="credits">
  {
    lines.map((line, i) => (
      <p class:list={["line", { name: i === lines.length - 1 }]} data-credit-line={i}>
        {line}
      </p>
    ))
  }
</div>

<style>
  /* Increment 30: back to the pre-increment-25 treatment, by the owner's
     call — a soft --bg scrim behind the block and one soft --bg shadow per
     line, not increment 25's outline rings and off-white bloom. The scrim
     is a rounded panel blurred at the edges: it covers the whole text area
     at full strength and reads as the backdrop thinning out around the
     text, not as a box. Over the projector beam, measured with the dust
     frozen, it keeps crimson at AA (PRD §5.8). */
  .credits {
    position: relative;
    display: grid;
    gap: 0.35em;
    max-width: 100%;
    font-family: var(--font-display);
    /* Five lines since increment 30, so the size is capped by the pin's
       height as well as its width: the whole block, name included, is
       about 7.3 × this tall and must clear a short landscape pin. */
    font-size: clamp(1.75rem, min(7vw, calc((100dvh - var(--nav-height)) * 0.1)), 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .credits::before {
    content: "";
    position: absolute;
    inset: -2.5rem -3rem;
    z-index: -1;
    border-radius: 3rem;
    background-color: color-mix(in srgb, var(--bg) 94%, transparent);
    filter: blur(1.25rem);
    pointer-events: none;
    opacity: 0;
    transition: opacity 480ms ease;
  }

  /* The first stage is blank (increment 30), so the panel arrives with the
     first line rather than sitting as a dark patch in the empty beam. */
  .credits:has(.line[data-shown])::before {
    opacity: 1;
  }

  .line {
    margin: 0;
    color: var(--accent);
    text-shadow: 0 0 1.25rem var(--bg);
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity 480ms ease,
      transform 480ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* The name reads larger than the stage lines (increment 30), capped by
     the width so "Ventrapragada" alone still fits a 320px screen. */
  .line.name {
    margin-top: 0.3em;
    font-size: min(1.35em, 10.5vw);
    color: var(--heading);
  }

  .line[data-shown] {
    opacity: 1;
    transform: none;
  }

  /* Lines still accumulate one by one; they just land without moving. */
  @media (prefers-reduced-motion: reduce) {
    .line,
    .credits::before {
      transform: none;
      transition: none;
    }
  }
</style>
