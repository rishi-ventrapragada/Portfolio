---
// The credits block of the footer sequence (PRD §5.8, increment 23). Lines
// accumulate: each appears as its scroll zone is reached and then stays, so
// the block builds up into one assembled piece of text rather than one line
// replacing another. Every line is laid out from the start (hidden with
// opacity), so the block is already its final size and centred — a line
// arriving never pushes the others around. scripts/footer-scrub.ts sets
// data-shown; the server shows the first line, zone 0's state (increment
// 33 — increment 30's first stage was blank). The last line is the name,
// in --heading and larger; the rest are accent.
interface Props {
  lines: readonly string[];
}

const { lines } = Astro.props;
---

<div class="credits">
  {
    lines.map((line, i) => (
      <p class:list={["line", { name: i === lines.length - 1 }]} data-credit-line={i} data-shown={i === 0 ? "" : undefined}>
        {line}
      </p>
    ))
  }
</div>

<style>
  /* Increment 34: no shadow, ring or scrim of any kind. Increments 25–33
     put a --bg edge on the letters to hold them off the projector beam;
     the beam is gone (Footer.astro mounts the site's sky), and on --bg
     the crimson is 5.65:1 and the name 17:1 with nothing added (PRD §5.8).
     What the sky needs is ground, not an edge: each line is a box the
     width of its words, filled with --bg. On a --bg ground the box itself
     never shows; it only keeps stars out of the words, where a star beside
     a stroke measured as low as 1.0:1. Between and around the lines the
     sky shows as everywhere else. */
  .credits {
    position: relative;
    display: grid;
    gap: 0.35em;
    max-width: 100%;
    font-family: var(--font-display);
    /* Five lines since increment 30, so the size is capped by the pin's
       height as well as its width: the whole block, name included, is
       about 7.3 × this tall and must clear a short landscape pin. */
    font-size: clamp(1.75rem, min(7vw, calc((100dvh - var(--nav-height)) * 0.1)), 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .line {
    justify-self: center;
    margin: 0;
    padding-inline: 0.12em;
    background-color: var(--bg);
    color: var(--accent);
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity 480ms ease,
      transform 480ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* The name is the credit, the lines above it are the roles (increment
     34): the lighter weight and open tracking set it apart from their
     heavy crimson, and it stays the largest line (1.1× theirs from 375px
     up). Capped by the width so "Ventrapragada" alone still fits a 320px
     screen (241px of 272). The negative end margin takes back the
     tracking after the last letter, so the name centres on its glyphs. */
  .line.name {
    margin-top: 0.3em;
    margin-inline-end: -0.08em;
    font-size: min(1.1em, 8.2vw);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--heading);
  }

  .line[data-shown] {
    opacity: 1;
    transform: none;
  }

  /* Lines still accumulate one by one; they just land without moving. */
  @media (prefers-reduced-motion: reduce) {
    .line {
      transform: none;
      transition: none;
    }
  }
</style>
