---
// The credits block of the footer sequence (PRD §5.8, increment 23). Lines
// accumulate: each appears as its scroll zone is reached and then stays, so
// the block builds up into one assembled piece of text rather than one line
// replacing another. Every line is laid out from the start (hidden with
// opacity), so the block is already its final size and centred — a line
// arriving never pushes the others around. scripts/footer-scrub.ts sets
// data-shown. The last line is the name, in --heading; the rest are accent.
interface Props {
  lines: readonly string[];
}

const { lines } = Astro.props;
---

<div class="credits">
  {
    lines.map((line, i) => (
      <p class:list={["line", { name: i === lines.length - 1 }]} data-credit-line={i} data-shown={i === 0 ? "" : undefined}>
        {line}
      </p>
    ))
  }
</div>

<style>
  /* Increment 25: no panel behind the block — the words sit straight on
     the topographic backdrop and carry their own glow (.line below). */
  .credits {
    display: grid;
    gap: 0.35em;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* Two parts, and the order is load-bearing (the first shadow paints on
     top). --halo (Footer.astro, shared with the © line) is a solid --bg
     outline 3px deep — the letter shifted around two rings, 8 copies at
     1.5px and 12 at 3px, no blur — then a blurred falloff. That keeps the contour lines off the ground right at
     each stroke: crimson measured 2.51:1 over a contour with nothing there,
     and still 3.27 with blurred shadows alone, which are only half opaque
     at the letter's edge (PRD §5.8). Under it, a wide faint off-white
     bloom is the glow you see. A white glow cannot sit right behind the
     accent lines: crimson falls below 4.5:1 once the ground under it lifts
     past about 8%. */
  .line {
    margin: 0;
    color: var(--accent);
    text-shadow:
      var(--halo),
      0 0 2.5rem color-mix(in srgb, var(--heading) 16%, transparent);
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity 480ms ease,
      transform 480ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* The name is off-white text, so it can take a brighter glow of its own
     colour (still ~9:1 at a 20% lift). */
  .line.name {
    margin-top: 0.3em;
    color: var(--heading);
    text-shadow:
      var(--halo),
      0 0 1.5rem color-mix(in srgb, var(--heading) 30%, transparent),
      0 0 3rem color-mix(in srgb, var(--heading) 16%, transparent);
  }

  .line[data-shown] {
    opacity: 1;
    transform: none;
  }

  /* Lines still accumulate one by one; they just land without moving. */
  @media (prefers-reduced-motion: reduce) {
    .line {
      transform: none;
      transition: none;
    }
  }
</style>
