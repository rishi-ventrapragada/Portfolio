---
// PRD §5.8 — contact as a staged credits sequence (increment 21; increment
// 17's continuous crawl is gone). Still the <footer> landmark and still
// #contact for the nav. A scroll track (Wordmark.astro /
// ExperienceTimeline.astro technique) holds a sticky pin for its whole
// distance; inside it four stages are stacked in one grid cell
// (FooterStage.astro) and scroll progress through the pin commits one at a
// time — each settles into the same centred position and holds, then
// cross-fades to the next, so nothing ever leaves by the top edge.
// scripts/footer-scrub.ts owns the zone/commit path and the keyboard reveal.
// The credit wording is the owner's, split into rows.
import FooterContact from "./FooterContact.astro";
import FooterStage from "./FooterStage.astro";

const credits = [
  { id: "built", role: "Built with", name: "Astro · Tailwind · Vercel" },
  { id: "author", role: "Directed, developed & edited by", name: "Rishi" },
];
---

<footer class="footer" id="contact" data-credits>
  {/* Without JavaScript nothing commits a stage, so the <noscript> style
      (the ExperienceTimeline.astro pattern) un-pins the section into a
      static block and un-stacks the stages into plain flow: the same four
      in document order, ending on the contact card. */}
  <noscript>
    <style>
      [data-credits-track] { height: auto !important; }
      [data-credits-pin] { position: static !important; height: auto !important; overflow: visible !important; }
      [data-credits-stack] { display: block !important; }
      [data-credits-stage] { opacity: 1 !important; pointer-events: auto !important; transform: none !important; }
    </style>
  </noscript>

  <div class="track" data-credits-track>
    <div class="pin" data-credits-pin>
      {/* Every stage is in the HTML, stacked in one grid cell, so a swap is
          a cross-fade in a box that never moves. The first is active from
          the server, so the footer reads as a title card without JS. */}
      <div class="stack" data-credits-stack>
        <FooterStage id="title" active>
          <p class="title">Rishi Ventrapragada</p>
        </FooterStage>

        {
          credits.map((credit) => (
            <FooterStage id={credit.id}>
              <div class="credit">
                <p class="label role">{credit.role}</p>
                <p class="name">{credit.name}</p>
              </div>
            </FooterStage>
          ))
        }

        <FooterStage id="contact">
          <FooterContact />
        </FooterStage>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initFooterStages } from "../scripts/footer-scrub";

  const root = document.querySelector<HTMLElement>("[data-credits]");
  if (root) initFooterStages(root);
</script>

<style>
  /* --pin-inner: the pinned viewport less the fixed nav, which is opaque
     past the hero. Every stage is exactly this tall, so each settles with
     its content centred in the pin. */
  .footer {
    --pin-inner: calc(100dvh - var(--nav-height));
    border-top: 1px solid var(--line);
  }

  /* --pin-length is the one number to tune: the scroll distance the track
     occupies. The pin travels (--pin-length − 100dvh); each of the four
     stage zones is a quarter of that. */
  .track {
    --pin-length: 250vh;
    height: var(--pin-length);
  }

  /* overflow: clip, not hidden: it clips the stack without making the pin a
     scroll container, so focusing a link can never scroll the pin's own
     box out from under it. */
  .pin {
    position: sticky;
    top: 0;
    height: 100dvh;
    padding-top: var(--nav-height);
    overflow: clip;
  }

  /* The stages (FooterStage.astro) all take grid-area 1 / 1 here. */
  .stack {
    display: grid;
    height: 100%;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--size-h2);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--heading);
  }

  /* One credit per stage now, so the row is a centred pair rather than the
     old list: the role above the name, end-credit spacing kept. */
  .credit {
    display: grid;
    gap: 0.5rem;
    line-height: 2;
  }

  .role {
    margin: 0;
    color: var(--accent);
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 500;
    color: var(--fg);
  }

  /* --- Reduced motion ----------------------------------------------------- */
  /* The pin stays, unlike increment 17's roll. That roll moved content at a
     rate other than the scroll rate, and a differential rate is parallax
     (WCAG 2.3.3's own example), so it had to go. A stage commit is instead a
     discrete state change at a zone boundary — sticky is layout, not
     animation — so the mechanic adds no motion beyond the visitor's own
     scroll (the §5.11 rationale). Only the entrance goes: FooterStage.astro
     drops its transition, making each swap instant. */
</style>
