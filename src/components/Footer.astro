---
// PRD §5.8 — contact as a credits sequence. Still the <footer> landmark; the
// nav's #contact is an anchor at the END of the track (increment 28), so the
// link lands on the settled contact screen, not the first credit. A scroll
// track holds a sticky pin for its whole distance; inside it two stages
// share one grid cell (FooterStage.astro): the credits, then the contact
// screen.
//
// Increment 23: the credit lines ACCUMULATE. Each scroll zone adds one line
// and keeps the ones before it, so the block assembles in place
// (FooterCredits.astro). Since increment 30 there are six credit stages — a
// blank screen, then one line per zone up to the name, which holds the
// complete block — and the last zone cross-fades to the contact screen.
// scripts/footer-scrub.ts owns the zones and the keyboard reveal.
import FooterContact from "./FooterContact.astro";
import FooterCredits from "./FooterCredits.astro";
import FooterStage from "./FooterStage.astro";
import LeaderStrip from "./LeaderStrip.astro";
import ProjectorBeam from "./ProjectorBeam.astro";

// The credit, one line per entry, in the order they build up (the owner's
// copy, increment 30 — "And" spelled out). Plain text; the zones follow the
// number of lines, so remember --pin-length below. The last line is styled
// as the name.
const creditLines = ["Built", "Designed", "Directed", "And edited by", "Rishi Ventrapragada"];
---

{/* The Projects→Contact seam (PRD §5.12): the countdown leader (increment
    29). Outside the <footer> so the landmark still starts at the contact
    content. */}
<LeaderStrip />

<footer class="footer" data-credits>
  {/* Without JavaScript nothing commits a zone, so the <noscript> style
      (the ExperienceTimeline.astro pattern) un-pins the section into a
      static block, un-stacks the stages into plain flow and shows every
      credit line: the assembled credits, then the contact screen. Short
      screens get the same layout from the media query in the <style>
      below. The pin keeps clipping sideways: the scrim's negative inset
      (FooterCredits.astro) would otherwise widen a phone's page. A contact
      screen taller than its stage grows it, so the © line, pinned to the
      stage's bottom edge, gets room of its own below the résumé. */}
  <noscript>
    <style>
      [data-credits-track] { height: auto !important; }
      [data-credits-pin] { position: static !important; height: auto !important; overflow: clip visible !important; }
      [data-credits-stack] { display: block !important; }
      [data-credits-stage] { opacity: 1 !important; pointer-events: auto !important; transform: none !important; }
      [data-credit-line], .credits::before { opacity: 1 !important; transform: none !important; }
      [data-contact-anchor] { top: calc(100% - var(--pin-inner) - var(--nav-height)) !important; }
      [data-contact] { padding-bottom: 4.5rem !important; }
    </style>
  </noscript>

  <div class="track" data-credits-track>
    {/* The nav's target. Exactly one viewport above the track's end — the
        scroll position where the last zone has committed the contact
        screen — so a click, a tap and the keyboard all land there. Without
        JS the track is plain flow and this sits where the contact screen
        starts instead (the <noscript> rule above). */}
    <span class="anchor" id="contact" data-contact-anchor></span>
    <div class="pin" data-credits-pin>
      {/* Inside the pin, so the beam stays behind the credits for the
          whole scroll rather than travelling with the track. */}
      <ProjectorBeam />

      {/* Both stages are in the HTML, stacked in one grid cell, so the swap
          is a cross-fade in a box that never moves. The credits stage is
          active from the server with no line shown: the blank first stage. */}
      <div class="stack" data-credits-stack data-lines={creditLines.length}>
        <FooterStage id="credits" active>
          <FooterCredits lines={creditLines} />
        </FooterStage>

        <FooterStage id="contact">
          <FooterContact />
        </FooterStage>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initFooterStages } from "../scripts/footer-scrub";

  const root = document.querySelector<HTMLElement>("[data-credits]");
  if (root) initFooterStages(root);
</script>

<style>
  /* --pin-inner: the pinned viewport less the fixed nav, which is opaque
     past the hero. Every stage is exactly this tall, so each settles with
     its content centred in the pin. */
  .footer {
    --pin-inner: calc(100dvh - var(--nav-height));
  }

  /* --pin-length is the one number to tune: the scroll distance the track
     occupies. The pin travels (--pin-length − 100dvh), split evenly into a
     blank zone, one zone per credit line (the name's doubles as the hold)
     and the contact screen — seven zones for five lines, 40vh each, the
     same zone length as before increment 30. */
  .track {
    --pin-length: 380vh;
    position: relative;
    height: var(--pin-length);
  }

  /* scroll-margin 0, not the global nav allowance: the pin already clears
     the bar, and landing 80px short would stop one zone early on a short
     track. */
  .anchor {
    position: absolute;
    top: calc(100% - 100dvh);
    left: 0;
    width: 1px;
    height: 1px;
    scroll-margin-top: 0;
    pointer-events: none;
  }

  /* overflow: clip, not hidden: it clips the stack without making the pin a
     scroll container, so focusing a link can never scroll the pin's own
     box out from under it. */
  .pin {
    position: sticky;
    top: 0;
    height: 100dvh;
    padding-top: var(--nav-height);
    overflow: clip;
  }

  /* The stages (FooterStage.astro) all take grid-area 1 / 1 here. Lifted
     above the projector beam, which sits at z-index 0 in the pin. */
  .stack {
    position: relative;
    z-index: 1;
    display: grid;
    height: 100%;
  }

  /* --- Short screens (increment 32) ---------------------------------------
     Below the height the contact screen needs, the pin would clip it
     (WCAG 1.4.10 — at 400% zoom only GitHub showed), so the section takes
     the no-JS layout above: in flow, every line and both stages shown.
     Each band's number is the measured minimum pinned height plus 2px
     (SESSION.md, increment 32): 532 below 480px wide, 666 from 480 to
     959 (one column of full-size cards), 506 from 960. footer-scrub.ts
     reads the pin's position and stands down while it is static. */
  @media (max-height: 533.98px) and (max-width: 479.98px),
    (max-height: 667.98px) and (min-width: 480px) and (max-width: 959.98px),
    (max-height: 507.98px) {
    :global([data-credits-track]) { height: auto !important; }
    :global([data-credits-pin]) { position: static !important; height: auto !important; overflow: clip visible !important; }
    :global([data-credits-stack]) { display: block !important; }
    :global([data-credits-stage]) { opacity: 1 !important; pointer-events: auto !important; transform: none !important; }
    :global([data-credit-line]), :global(.credits::before) { opacity: 1 !important; transform: none !important; }
    :global([data-contact-anchor]) { top: calc(100% - var(--pin-inner) - var(--nav-height)) !important; }
    :global([data-contact]) { padding-bottom: 4.5rem !important; }
  }

  /* --- Reduced motion ----------------------------------------------------- */
  /* The pin stays, unlike increment 17's roll. That roll moved content at a
     rate other than the scroll rate, and a differential rate is parallax
     (WCAG 2.3.3's own example), so it had to go. A stage commit is instead a
     discrete state change at a zone boundary — sticky is layout, not
     animation — so the mechanic adds no motion beyond the visitor's own
     scroll (the §5.11 rationale). Only the entrance goes: FooterStage.astro
     drops its transition, making each swap instant. */
</style>
