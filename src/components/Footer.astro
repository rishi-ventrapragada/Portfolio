---
// PRD §5.8 — contact as a credits sequence. Still the <footer> landmark; the
// nav's #contact is an anchor at the END of the track (increment 28), so the
// link lands on the settled contact screen, not the first credit. A scroll track holds a sticky pin for its
// whole distance; inside it two stages share one grid cell
// (FooterStage.astro): the credits, then the contact screen.
//
// Increment 23: the credit lines ACCUMULATE. Each scroll zone adds one line
// and keeps the ones before it, so the block assembles in place
// (FooterCredits.astro); one more zone holds it complete, and the last
// cross-fades to the contact screen. scripts/footer-scrub.ts owns the zones
// and the keyboard reveal.
import FooterContact from "./FooterContact.astro";
import FooterCredits from "./FooterCredits.astro";
import FooterStage from "./FooterStage.astro";
import LoopDivider from "./LoopDivider.astro";
import TopoBackdrop from "./TopoBackdrop.astro";

// The credit, one line per entry, in the order they build up. Plain text —
// regroup or reword freely; the zones follow the number of lines. The last
// line is styled as the name.
const creditLines = ["Built, designed,", "Directed & edited by", "Rishi Ventrapragada"];
---

{/* The Projects→Contact seam (PRD §5.12): the checkered finish-line flag.
    Outside the <footer> so the landmark still starts at the contact
    content. */}
<LoopDivider variant="checker" />

<footer class="footer" data-credits>
  {/* Without JavaScript nothing commits a zone, so the <noscript> style
      (the ExperienceTimeline.astro pattern) un-pins the section into a
      static block, un-stacks the stages into plain flow and shows every
      credit line: the assembled credits, then the contact screen. */}
  <noscript>
    <style>
      [data-credits-track] { height: auto !important; }
      [data-credits-pin] { position: static !important; height: auto !important; overflow: visible !important; }
      [data-credits-stack] { display: block !important; }
      [data-credits-stage] { opacity: 1 !important; pointer-events: auto !important; transform: none !important; }
      [data-credit-line] { opacity: 1 !important; transform: none !important; }
      [data-contact-anchor] { top: calc(100% - var(--pin-inner) - var(--nav-height)) !important; }
    </style>
  </noscript>

  <div class="track" data-credits-track>
    {/* The nav's target. Exactly one viewport above the track's end — the
        scroll position where the last zone has committed the contact
        screen — so a click, a tap and the keyboard all land there. Without
        JS the track is plain flow and this sits where the contact screen
        starts instead (the <noscript> rule above). */}
    <span class="anchor" id="contact" data-contact-anchor></span>
    <div class="pin" data-credits-pin>
      {/* Inside the pin, so the contours stay behind the credits for the
          whole scroll rather than travelling with the track. */}
      <TopoBackdrop />

      {/* Both stages are in the HTML, stacked in one grid cell, so the swap
          is a cross-fade in a box that never moves. The credits are active
          from the server with their first line shown. */}
      <div class="stack" data-credits-stack data-lines={creditLines.length}>
        <FooterStage id="credits" active>
          <FooterCredits lines={creditLines} />
        </FooterStage>

        <FooterStage id="contact">
          <FooterContact />
        </FooterStage>
      </div>
    </div>
  </div>
</footer>

<script>
  import { initFooterStages } from "../scripts/footer-scrub";

  const root = document.querySelector<HTMLElement>("[data-credits]");
  if (root) initFooterStages(root);
</script>

<style>
  /* --pin-inner: the pinned viewport less the fixed nav, which is opaque
     past the hero. Every stage is exactly this tall, so each settles with
     its content centred in the pin. */
  .footer {
    --pin-inner: calc(100dvh - var(--nav-height));
  }

  /* --pin-length is the one number to tune: the scroll distance the track
     occupies. The pin travels (--pin-length − 100dvh), split evenly into one
     zone per credit line, a hold on the assembled block, and the contact
     screen — five zones for three lines, 40vh each. */
  .track {
    --pin-length: 300vh;
    position: relative;
    height: var(--pin-length);
  }

  /* scroll-margin 0, not the global nav allowance: the pin already clears
     the bar, and landing 80px short would stop one zone early on a short
     track. */
  .anchor {
    position: absolute;
    top: calc(100% - 100dvh);
    left: 0;
    width: 1px;
    height: 1px;
    scroll-margin-top: 0;
    pointer-events: none;
  }

  /* overflow: clip, not hidden: it clips the stack without making the pin a
     scroll container, so focusing a link can never scroll the pin's own
     box out from under it. */
  .pin {
    position: sticky;
    top: 0;
    height: 100dvh;
    padding-top: var(--nav-height);
    overflow: clip;
  }

  /* The stages (FooterStage.astro) all take grid-area 1 / 1 here. Lifted
     above the topographic backdrop, which sits at z-index 0 in the pin. */
  .stack {
    position: relative;
    z-index: 1;
    display: grid;
    height: 100%;
  }

  /* --- Reduced motion ----------------------------------------------------- */
  /* The pin stays, unlike increment 17's roll. That roll moved content at a
     rate other than the scroll rate, and a differential rate is parallax
     (WCAG 2.3.3's own example), so it had to go. A stage commit is instead a
     discrete state change at a zone boundary — sticky is layout, not
     animation — so the mechanic adds no motion beyond the visitor's own
     scroll (the §5.11 rationale). Only the entrance goes: FooterStage.astro
     drops its transition, making each swap instant. */
</style>
