---
// PRD 5.8 — minimal contact. No form at launch.
const year = new Date().getFullYear();

const links = [
  { label: "Email", href: "mailto:rishiventrapragada23@gmail.com" },
  { label: "GitHub", href: "https://github.com/rishi-ventrapragada" },
  { label: "LinkedIn", href: "https://linkedin.com/in/rishi-ventrapragada" },
  { label: "Résumé [TODO]", href: "/resume.pdf" },
];
---

<footer class="footer" id="contact">
  <div class="shell inner">
    <p class="label get-in-touch">Get in touch</p>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a class="meta link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="meta copyright">&copy; {year} Sai Rishi Ventrapragada</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: var(--rhythm) 2rem;
  }

  .inner {
    display: grid;
    gap: 1.5rem;
  }

  .get-in-touch {
    color: var(--accent);
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    color: var(--fg);
  }

  .link:hover {
    color: var(--accent);
  }

  .copyright {
    margin: 0;
  }
</style>
