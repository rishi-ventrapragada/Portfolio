---
// The Experience heading (PRD §5.11): eyebrow and h2 in the monitor's
// top-left corner, above the frames, for every clip. Increment 33 moved it
// into the monitor from a band of its own above it (increment 30), and took
// that band's Starfield away: the section is the editor alone, and it is
// the one content section with no sky. On the black monitor there are no
// stars to clear, so the text needs no .halo. ExperienceTimeline.astro
// renders it; split for the CLAUDE.md §5 cap.
---

<div class="head">
  <p class="label eyebrow">Journey</p>
  <h2 id="experience-heading" class="heading">Experience</h2>
</div>

<style>
  /* Aligned with every other section's heading (the .shell's left edge
     and top rhythm, compact); the frames fill the monitor below it. */
  .head {
    flex: none;
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 1.25rem var(--gutter) 0;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--accent);
  }

  .heading {
    margin: 0;
    font-size: var(--size-h2);
  }

  /* Short landscape (≤500px tall, e.g. 844×390): eyebrow and heading share
     one row at a smaller size, so the frames keep their room
     (ExperienceFrame.astro shrinks its text to match). */
  @media (max-height: 500px) {
    .head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding-top: 0.5rem;
    }

    .eyebrow {
      margin: 0;
    }

    .heading {
      font-size: 1.5rem;
    }
  }
</style>
