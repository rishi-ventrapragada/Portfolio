---
// The loading square (PRD §5.10). An 8×8 grid of cells that fill one by one
// in the fixed, scattered order in boot-fill.ts — chunk-by-chunk pop-in like
// the reference footage, replacing increment 9's centre-out layers. Split out
// of BootPreloader.astro for the CLAUDE.md §5 line cap; boot-preloader.ts
// flips each cell's data-on and data-lead, which style scoping leaves
// untouched.
//
// Every cell renders unfilled, so the frame before script runs shows the
// empty box and never a filled one.
import { CELLS } from "../scripts/boot-fill";
const cells = Array.from({ length: CELLS }, (_, i) => i);
---

<div class="boot-square" data-square>
  {cells.map((i) => <span class="boot-cell" data-cell={i}></span>)}
</div>

<style>
  .boot-square {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    /* 2px gaps so the cells read as distinct blocks, not a smooth surface. */
    gap: 2px;
    width: clamp(120px, 20vw, 180px);
    aspect-ratio: 1;
    /* Darker than --bg so the unfilled box reads as a distinct object against
       the noise texture behind it. The gaps show this colour too. */
    background-color: var(--boot-square-bg);
  }

  .boot-cell {
    /* Unfilled: invisible over the box, so only filled cells draw. */
    background-color: transparent;
    /* A pop that settles, not a slide: short and ease-out. */
    transition: background-color 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Not --accent, so a filled cell reads the same under both accents. */
  .boot-cell[data-on] {
    background-color: var(--heading);
  }

  /* The two newest cells carry the accent until the next step lands, then
     settle to --heading: a leading edge that shows where the fill is now, and
     the one accent-switchable element on the boot screen (the old ring's job).
     Chosen over a plain fill by eye, both built (increment 12). */
  .boot-cell[data-lead] {
    background-color: var(--accent);
  }

  /* The overlay never renders under reduced motion (BootPreloader.astro), so
     this is belt and braces per CLAUDE.md §4. */
  @media (prefers-reduced-motion: reduce) {
    .boot-cell {
      transition: none;
    }
  }
</style>
