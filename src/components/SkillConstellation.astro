---
// Video-editing skills as one constellation (PRD §5.6, increment 20): nine
// named stars joined by accent lines into one shape — the second Skills
// section, never merged with SkillTree.astro. Content is the owner's,
// verbatim. The lines are one SVG stretched to the box (non-scaling strokes);
// the stars and names are HTML at the same percentages, so type never scales.
// Every name is visible and is its star's accessible name; no hover, no links.
//
// The figure turns and drifts as one rigid shape (increment 23, replacing
// the CSS drift of the whole box): scripts/constellation-motion.ts turns the
// stars about their centroid, carries each line's ends with them and keeps
// the names upright, which a CSS rotate could not. Each name's side is solved
// at build time so no name touches a line at any angle reached
// (lib/constellation-labels.ts).
import { lineEnds, lines, specks, stars } from "../lib/constellation-data";
import { TURN_DEG } from "../lib/constellation-labels";
import ConstellationStar from "./ConstellationStar.astro";
import Starfield from "./Starfield.astro";
---

<section class="video shell" id="skills-video" aria-labelledby="skills-video-heading">
  <Starfield />

  <p class="label eyebrow">Also</p>
  <h2 id="skills-video-heading" class="heading">Video editing</h2>

  {/* data-constellation, not just .sky: Starfield.astro uses a .sky of its
      own and one is mounted in this section, so the class alone is
      ambiguous to anything selecting into the page. */}
  {/* Without JS the line cuts below are never drawn, so the names get back
      an opaque ground to sit on instead. */}
  <noscript><style>[data-constellation] .name { background-color: var(--bg); text-shadow: none; }</style></noscript>

  <div class="sky" data-constellation data-turn-phone={TURN_DEG.phone} data-turn-wide={TURN_DEG.wide}>
    <div class="specks" aria-hidden="true">
      {specks.map(([x, y, s]) => <span class="speck" style={`left: ${x}%; top: ${y}%; --s: ${s}px`} />)}
    </div>

    <svg class="lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {/* Line routing: one black cut per name, positioned by the script, so
          no line is ever drawn under the letters (lib/constellation-labels.ts). */}
      <mask id="constellation-cuts" maskUnits="userSpaceOnUse" x="-20" y="-20" width="140" height="140">
        <rect x="-20" y="-20" width="140" height="140" fill="white" />
        {stars.map(() => <rect class="cut" width="0" height="0" fill="black" />)}
      </mask>
      <g mask="url(#constellation-cuts)">
        {
          lines.map(([a, b], i) => (
            <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} data-a={lineEnds[i][0]} data-b={lineEnds[i][1]} vector-effect="non-scaling-stroke" />
          ))
        }
      </g>
    </svg>

    <ul class="stars">
      {
        stars.map((star, i) => <ConstellationStar {...star} index={i} />)
      }
    </ul>
  </div>
</section>

<script>
  import { initConstellation } from "../scripts/constellation-motion";

  const box = document.querySelector<HTMLElement>("[data-constellation]");
  if (box) initConstellation(box);
</script>

<style>
  /* Positioned so the Starfield bounds itself here; content sits above it. */
  .video {
    position: relative;
    padding-block: var(--rhythm);
  }

  .eyebrow,
  .heading,
  [data-constellation] {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .heading {
    margin: 0 0 2rem;
    font-size: var(--size-h2);
  }

  /* The box every percentage refers to. Portrait on a phone so the nine
     bands have room; 16:10 from 768px, capped so the shape stays a cluster
     rather than a sprawl on wide screens. Its contents are moved by
     scripts/constellation-motion.ts; the box itself never moves. */
  [data-constellation] {
    position: relative;
    max-width: 960px;
    margin-inline: auto;
    aspect-ratio: 2 / 3;
  }

  @media (min-width: 768px) {
    [data-constellation] {
      aspect-ratio: 16 / 10;
    }
  }

  .specks,
  .lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .speck {
    position: absolute;
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    border-radius: 50%;
    background-color: var(--fg-muted);
    opacity: 0.4;
  }

  /* Every line is 2px accent at full opacity, under both accents, like the
     tree's connectors. */
  .lines {
    overflow: visible;
    color: var(--accent);
  }

  .lines line {
    stroke: currentColor;
    stroke-width: 2;
  }

  .stars {
    margin: 0;
    padding: 0;
    list-style: none;
  }

</style>
