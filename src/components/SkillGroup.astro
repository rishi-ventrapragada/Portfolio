---
// One category of the skill tree (PRD §5.6): a root node, a fan of two
// connector lines, and the leaves (SkillChain.astro). From 960px the group
// is a small talent tree — root centred over the chain's two columns, the
// fan reaching each column's head. Below 960px it is the root over the
// chain's spine. The "Currently learning" group keeps the same anatomy with
// an outlined root and dashed lines. No client script.
import SkillChain from "./SkillChain.astro";

interface Props {
  name: string;
  items: string[];
  /** Currently learning: outlined root, dashed fan, `.planned` leaves. */
  learning?: boolean;
}

const { name, items, learning = false } = Astro.props;
---

<li class="group" data-planned={learning ? "" : undefined}>
  <h3 class="label root">{name}</h3>

  {/* Two lines from the root's bottom centre to each column's top centre.
      preserveAspectRatio="none" stretches the 2×1 box to the row, which
      keeps straight lines straight; non-scaling-stroke keeps them 2px. */}
  <svg class="fan" viewBox="0 0 2 1" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <line x1="1" y1="0" x2="0.5" y2="1" vector-effect="non-scaling-stroke"></line>
    <line x1="1" y1="0" x2="1.5" y2="1" vector-effect="non-scaling-stroke"></line>
  </svg>

  <SkillChain items={items} learning={learning} />
</li>

<style>
  .group {
    list-style: none;
  }

  /* Root: solid accent, dark text (light text fails contrast on both
     accents), uppercase mono. A touch taller than a leaf, never wider than
     its chain. Below 960px it sits over the chain's spine. */
  .root {
    display: inline-block;
    margin: 0 0 0 1rem;
    padding: 0.625rem 1rem;
    text-align: center;
    color: var(--bg);
    background-color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
  }

  .fan {
    display: none;
    color: var(--accent);
  }

  .fan line {
    stroke: currentColor;
    stroke-width: 2;
  }

  /* --- From 960px: the talent tree ----------------------------------- */
  @media (min-width: 960px) {
    .group {
      display: grid;
      grid-template-rows: auto 28px auto;
      align-content: start;
    }

    .root {
      display: block;
      justify-self: center;
      width: 70%;
      margin: 0;
    }

    .fan {
      display: block;
      width: 100%;
      height: 28px;
    }
  }

  /* --- Currently learning: outlined root, dashed fan ------------------ */
  .group[data-planned] .root {
    color: var(--accent);
    background-color: transparent;
    border-style: dashed;
  }

  .group[data-planned] .fan line {
    stroke-dasharray: 4 4;
  }
</style>
