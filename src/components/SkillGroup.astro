---
// One category of the skill tree (PRD §5.6). Two layouts, both in the markup,
// each shown at its own width:
//
// From 960px — a free-scatter mind map (increment 22, replacing the column
// fan). Every leaf sits at its own build-time position around the root and is
// joined to it by its own straight line. Lines crossing each other is the
// intended hand-drawn look; labels never overlap, which skill-scatter.ts
// guarantees by relaxation and asserts at build time.
//
// Below 960px — increment 19's stacked spine-and-chain (SkillChain.astro),
// deliberately unchanged: free scatter and narrow screens are a bad
// combination and legibility is not negotiable.
//
// "Currently learning" keeps the same anatomy with an outlined root, dashed
// lines and `.planned` leaves. From increment 23 the scatter moves: the
// positions here are each leaf's home, and scripts/skill-drift.ts drifts,
// turns and drags them from there (data-x / data-y carry the home to it).
import { extent, scatter } from "../lib/skill-scatter";
import SkillChain from "./SkillChain.astro";

interface Props {
  name: string;
  items: string[];
  /** Currently learning: outlined root, dashed lines, `.planned` leaves. */
  learning?: boolean;
}

const { name, items, learning = false } = Astro.props;

const leaves = scatter(name, items);
// extent() is already symmetric about the root, which sits at the canvas
// centre; a few px of slack keeps borders and the 2px rays off the edge.
const box = extent(leaves);
const canvasW = box.w + 16;
const canvasH = box.h + 16;
---

<li class="group" style={`--w: ${canvasW}px; --h: ${canvasH}px`} data-planned={learning ? "" : undefined} data-skill-group>
  <h3 class="label root">{name}</h3>

  {/* One line per leaf, root centre to leaf centre. The viewBox is the
      canvas in px so the coordinates are the same numbers as the leaves'
      offsets; non-scaling-stroke keeps every line 2px. Desktop only. */}
  <svg
    class="rays"
    viewBox={`${-canvasW / 2} ${-canvasH / 2} ${canvasW} ${canvasH}`}
    aria-hidden="true"
    focusable="false"
  >
    {leaves.map((leaf) => <line x1="0" y1="0" x2={leaf.x} y2={leaf.y} vector-effect="non-scaling-stroke" />)}
  </svg>

  <ul class="scatter">
    {
      leaves.map((leaf) => (
        <li
          class:list={["leaf", { planned: learning }]}
          style={`--x: ${leaf.x}px; --y: ${leaf.y}px`}
          data-x={leaf.x.toFixed(2)}
          data-y={leaf.y.toFixed(2)}
        >
          {leaf.item}
        </li>
      ))
    }
  </ul>

  <SkillChain items={items} learning={learning} />
</li>

<style>
  .group {
    list-style: none;
  }

  /* Root: solid accent, dark text (light text fails contrast on both
     accents), uppercase mono. Below 960px it sits over the chain's spine. */
  .root {
    display: inline-block;
    margin: 0 0 0 1rem;
    padding: 0.625rem 1rem;
    text-align: center;
    color: var(--on-accent);
    background-color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
  }

  /* The scatter is desktop-only; below 960px SkillChain owns the layout. */
  .rays,
  .scatter {
    display: none;
  }

  /* --- From 960px: the free-scatter mind map -------------------------- */
  @media (min-width: 960px) {
    .group {
      position: relative;
      width: var(--w);
      height: var(--h);
    }

    /* Root centred on the canvas; every leaf offset is measured from here.
       nowrap is load-bearing: skill-scatter.ts sizes the root's obstacle box
       from a one-line estimate, so a wrapping chip would be taller than the
       area the leaves were pushed out of. */
    .root {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;
      margin: 0;
      white-space: nowrap;
      transform: translate(-50%, -50%);
    }

    .rays {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      color: var(--accent);
      overflow: visible;
    }

    .rays line {
      stroke: currentColor;
      stroke-width: 2;
    }

    .scatter {
      display: block;
      position: absolute;
      inset: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* A leaf is a label centred on its own point, over the lines. In
       @layer components, like SkillChain's nodes, so the shared unlayered
       `.planned` utility wins border-style: unlayered, this scoped rule
       outranked it and the learning leaves stayed solid (increment 28). */
    @layer components {
      .leaf {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 1;
        padding: 0.5rem 0.625rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        letter-spacing: 0.04em;
        line-height: 1.2;
        white-space: nowrap;
        color: var(--fg);
        background-color: var(--bg-raised);
        border: 1px solid var(--line);
        border-radius: 4px;
        transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y)));
      }
    }

    /* Draggable where a fine pointer can hold it (scripts/skill-drag.ts). */
    @media (pointer: fine) {
      .leaf {
        cursor: grab;
        user-select: none;
        touch-action: none;
      }

      .group[data-dragging] .leaf {
        cursor: grabbing;
      }
    }

    /* The chain is the mobile layout; hide it once the scatter is on. */
    .group :global(.chain) {
      display: none;
    }
  }

  /* --- Currently learning: outlined root, dashed lines ----------------- */
  /* The ground is --bg, not transparent: the rays start at the root's
     centre, and an empty chip let the dashed lines run through its text. */
  .group[data-planned] .root {
    color: var(--accent);
    background-color: var(--bg);
    border-style: dashed;
  }

  .group[data-planned] .rays line {
    stroke-dasharray: 4 4;
  }
</style>
