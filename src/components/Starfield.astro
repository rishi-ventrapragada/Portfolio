---
// A drifting star sky behind a section (PRD §5.14), ported from the Recurzn /
// Life OS effect. Three parallax layers drift left at different speeds; the
// two nearer ones twinkle; three meteors cross on coprime periods, at
// Recurzn's own scale (StarfieldMeteors.astro, split for the line cap).
// Positions are generated at build time (lib/starfield-data.ts).
//
// Since increment 28 the stars are not elements. Every star of every layer
// is a box-shadow in a list defined ONCE per page (StarfieldDefs.astro, in
// the <head>); a mount is a dozen-odd elements that paint those lists — one
// per twinkle group — so five mounts no longer ship 800 spans.
//
// Monochrome on purpose: every star, twinkle and streak is --heading, the
// wordmark's off-white. The accent belongs to the interface, not the sky.
//
// Bounded to its own section: contain: strict plus overflow: clip means it
// can never paint into a neighbour, so the dividers stay the visible seam.
import { layers } from "../lib/starfield-data";
import StarfieldMeteors from "./StarfieldMeteors.astro";
---

<div class="sky" data-sky aria-hidden="true">
  {
    layers.map((layer) => (
      <div class="layer" data-layer={layer.name} style={`--drift: ${layer.drift}s; --layer-opacity: ${layer.opacity}`}>
        {/* 200% wide and translated -50%: every star is also drawn one layer
            width to the right, so the wrap is invisible. */}
        <div class="track">
          {layer.groups.map((group) => (
            <span
              class="stars"
              data-twinkle={layer.twinkles ? "" : undefined}
              style={`box-shadow: var(${group.prop}); --dur: ${group.duration}s; --delay: ${group.delay}s`}
            />
          ))}
        </div>
      </div>
    ))
  }

  <StarfieldMeteors />
</div>

<style>
  /* contain: strict — the sky is decorative and fixed-size, so the browser
     can skip it entirely when off-screen, and nothing inside can affect
     layout outside. */
  .sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    contain: strict;
    pointer-events: none;
  }

  /* A size container: every star offset is in cqw / cqh of the layer, so
     the sky scales with its section and the seam copy is exactly one layer
     width (100cqw) to the right. */
  .layer {
    position: absolute;
    inset: 0;
    container-type: size;
    opacity: var(--layer-opacity);
  }

  /* will-change on the two moving wrappers only: a layer is one composited
     surface. */
  .layer[data-layer="near"],
  .layer[data-layer="mid"] {
    will-change: transform;
  }

  .track {
    position: absolute;
    inset: 0;
    width: 200%;
    animation: drift var(--drift) linear infinite;
  }

  /* Half the track is one full repeat, so ending at -50% lands the copy
     exactly where the original began — no seam at the loop point. */
  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* One twinkle group: a 1px round dot at the track's corner that paints
     nothing itself — its stars are its shadows. Shadows without a colour
     take currentColor, so the whole sky follows --heading. */
  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    color: var(--heading);
  }

  .stars[data-twinkle] {
    animation: twinkle var(--dur) ease-in-out var(--delay) infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  /* --- Reduced motion --------------------------------------------------
     The drift freezes at frame 0 and the twinkle settles to its base
     opacity, leaving a complete, still sky rather than an empty box. The
     meteors stop too (StarfieldMeteors.astro owns that branch). */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }

    .stars[data-twinkle] {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
