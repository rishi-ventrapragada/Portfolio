---
// Skills grouped by what they shipped with (PRD §5.6). Groups come in as a
// prop; a group with an `href` links every item there, otherwise items are
// plain text.
export interface SkillGroup {
  name: string;
  items: string[];
  href: string | null;
}

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="groups">
  {
    groups.map((group) => (
      <div class="group">
        <h3 class="label group-name">{group.name}</h3>
        <ul class="items">
          {group.items.map((item) => (
            <li>{group.href ? <a href={group.href}>{item}</a> : item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .groups {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }

  .group-name {
    margin: 0 0 0.75rem;
    color: var(--accent);
  }

  .items {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--fg);
  }
</style>
