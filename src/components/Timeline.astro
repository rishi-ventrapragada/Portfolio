---
// Vertical timeline: mono dates left, text right, joined by a thin rule.
// Entries come in as a prop so a future Community page can reuse this.
export interface TimelineEntry {
  date: string;
  text: string;
  /** Marks the most recent entry with an accent dot. */
  current?: boolean;
}

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<ol class="timeline">
  {
    entries.map((entry) => (
      <li class="entry" data-current={entry.current ? "" : undefined}>
        <span class="marker" aria-hidden="true" />
        <span class="meta date">{entry.date}</span>
        <span class="text">{entry.text}</span>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    position: relative;
    display: grid;
    gap: 0.25rem 1.25rem;
    padding-left: 1.75rem;
  }

  /* The rule is drawn per entry and stretched past the gap, so the line is
     continuous without a separate absolutely-positioned track. */
  .entry::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: -1.25rem;
    left: 3px;
    width: 1px;
    background-color: var(--line);
  }

  .entry:last-child::before {
    display: none;
  }

  .marker {
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 7px;
    height: 7px;
    border: 1px solid var(--fg-muted);
    border-radius: 50%;
    background-color: var(--bg);
  }

  .entry[data-current] .marker {
    border-color: var(--accent);
    background-color: var(--accent);
  }

  .date {
    color: var(--fg-muted);
  }

  .entry[data-current] .date {
    color: var(--accent);
  }

  .text {
    color: var(--fg);
  }

  /* Date beside the text once there is room for a column. */
  @media (min-width: 768px) {
    .entry {
      grid-template-columns: 4rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
</style>
