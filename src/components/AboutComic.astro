---
// DORMANT since increment 29 — not imported anywhere. The About comic page
// (PRD §5.6): five panels (AboutPanel.astro) in the shell, a clock-driven
// colour grade and a first-sight reveal (scripts/about-reveal.ts). Its art
// and dialogue are still visibly marked placeholders (CLAUDE.md §7), and
// increment 29 took it off the live page so visitors never see "[TODO]"
// text; About.astro shows the owner's approved bio instead. To bring the
// comic back once real panel art and captions exist: render <AboutComic />
// in About.astro in place of the bio block. Nothing here was changed in the
// move.
//
// Colour grade: one CSS animation on the grid cycles a `filter` through full
// colour → grayscale → warm duotone and back, so every panel shifts together.
// It runs on the clock, not on scroll (owner's decision), and needs no
// script. Reduced motion removes the animation, which leaves the filter at
// its rest value — frozen on full colour. Paused off-screen
// (scripts/offscreen-pause.ts).
//
// Reveal (increment 23): each panel fades up the first time it scrolls into
// view and then stays (scripts/about-reveal.ts). Normal scroll, no pinning.
import AboutPanel from "./AboutPanel.astro";

// The five fills come from the small palette in global.css (all five words
// are now in use). The first panel is the establishing shot: two columns by
// two rows on desktop, first in the stack on a phone.
const panels = [
  { n: 1, tone: "amber", establishing: true },
  { n: 2, tone: "sky" },
  { n: 3, tone: "mint" },
  { n: 4, tone: "periwinkle" },
  { n: 5, tone: "coral" },
] as const;
---

{/* The panels sit in the shell, so they line up with the heading and stop
    at its gutter (increment 23 — edge to edge, the grid read as spilling off
    the page). */}
<div class="shell">
  <div class="page" data-about-page data-offscreen-pause>
    {panels.map((panel) => <AboutPanel {...panel} />)}
  </div>
</div>

<script>
  import { initAboutReveal } from "../scripts/about-reveal";

  const page = document.querySelector<HTMLElement>("[data-about-page]");
  if (page) initAboutReveal(page);
</script>

<style>
  /* Phone: one column, the establishing panel first. The gap is the page
     background showing between the panels' hairline borders. Inside the
     shell, so its edges are the heading's gutter, never the viewport's. */
  .page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    animation: grade 15s linear infinite;
  }

  /* From 768px: four columns by two rows, the establishing panel spanning
     the left half. aspect-ratio makes each cell roughly square without a
     fixed height; max-height caps it at the viewport below the fixed bar, so
     on a short wide screen the whole page still fits in view at once rather
     than running up under the nav (the rows just get shorter). */
  @media (min-width: 768px) {
    .page {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      aspect-ratio: 2 / 1;
      max-height: calc(100dvh - var(--nav-height) - 2rem);
    }

    .page > :global(.establishing) {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
  }

  /* Three 5s holds with ~0.6s crossfades between them (15s loop). Every
     keyframe lists the same four functions in the same order so the browser
     interpolates the filter instead of snapping. The rest value (the first
     keyframe) is full colour: filters at their identity. */
  @keyframes grade {
    0%,
    31% {
      filter: grayscale(0) sepia(0) saturate(1) hue-rotate(0deg);
    }
    35%,
    64% {
      filter: grayscale(1) sepia(0) saturate(1) hue-rotate(0deg);
    }
    68%,
    97% {
      filter: grayscale(0) sepia(1) saturate(1.3) hue-rotate(-15deg);
    }
    100% {
      filter: grayscale(0) sepia(0) saturate(1) hue-rotate(0deg);
    }
  }

  /* A recurring filter change is motion (CLAUDE.md §4): freeze on full
     colour rather than keep cycling. No animation means no filter at all. */
  @media (prefers-reduced-motion: reduce) {
    .page {
      animation: none;
    }
  }
</style>
