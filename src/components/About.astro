---
// About (PRD §5.6). Since increment 29 this shows the owner's approved bio as
// plain text: a TEMPORARY content swap, not a design decision. The comic page
// (AboutComic.astro, with AboutPanel.astro and scripts/about-reveal.ts) is
// kept intact but not rendered, because its art and dialogue are still
// "[TODO]" placeholders that visitors should never see (CLAUDE.md §7). Swap
// the .bio block below for <AboutComic /> once real panel art and captions
// exist. The copy is the owner's, verbatim.
const bio =
  "CSE (Data Science) student at VJIT, started 2025. I build things end to end — plan the architecture, make the calls, and use AI tools like Claude Code to implement fast. KalaCart, an artisan marketplace built for Smart India Hackathon 2026, is the first thing I've shipped that had to survive contact with a real deadline and a real ministry review.";
const club = "Production team member, GDG on Campus VJIT — social media and video editing for the club's channels.";
---

{/* Light-scoped (PRD §5.16). No top rule: the hero subject fades into this
    section, and a hairline right under the fade would read as a cut. */}
<section class="about" id="about" data-theme="light" aria-labelledby="about-heading">
  <div class="shell">
    <p class="label eyebrow">Origin story</p>
    <h2 id="about-heading" class="heading">About</h2>

    <div class="bio">
      <p class="lede">{bio}</p>
      <p class="club">{club}</p>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--rhythm);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .heading {
    margin: 0 0 2.5rem;
    font-size: var(--size-h2);
  }

  /* A reading measure, not the full shell: ~34em of display type. */
  .bio {
    display: grid;
    gap: 1.5rem;
    max-width: 44rem;
  }

  .lede,
  .club {
    margin: 0;
  }

  .lede {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--fg);
  }

  .club {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }
</style>
