---
// The nav's scroll progress (PRD §5.1): the bar's bottom hairline, with an
// --accent fill growing left to right past the hero. Split from Nav.astro
// for the CLAUDE.md §5 cap (increment 32). It reads the bar's
// [data-past-hero] (scripts/nav.ts), so it must stay inside [data-nav].
// Inside the hero the fill would read as a broken near-empty line, so it is
// hidden until then and its range starts at the hero's bottom edge.
// aria-hidden: it duplicates what the scrollbar already says.
---

<div class="progress" aria-hidden="true">
  <span class="fill" data-progress-fill></span>
</div>

<style>
  /* The track is the bar's bottom hairline. No transition on the fill: it
     tracks scroll 1:1, also under reduced motion — it never moves by itself.
     Hidden over the hero with visibility/opacity, never `display: none`,
     which would collapse the hairline out of layout. */
  .progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background-color: var(--line);
    visibility: hidden;
    opacity: 0;
    /* Hide: fade, then drop visibility. Show (below): visibility at once. */
    transition:
      opacity 300ms ease,
      visibility 0s linear 300ms;
  }

  :global([data-past-hero]) .progress {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 300ms ease,
      visibility 0s linear 0s;
  }

  .fill {
    display: block;
    height: 100%;
    background-color: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--scroll-progress, 0));
  }

  @keyframes progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @supports (animation-timeline: scroll()) {
    /* Longhands in their own rules, never the `animation` shorthand: folded
       together the minifier emits `animation: ... scroll(root)` and browsers
       drop the whole declaration (CLAUDE.md §4). The :where(.progress)
       prefix keeps this rule from merging with the one below. */
    :where(.progress) .fill {
      animation-name: progress-grow;
      animation-duration: 1ms; /* Overridden by the timeline. */
      animation-timing-function: linear;
      animation-fill-mode: both;
    }

    /* Range starts at the hero's bottom (one viewport) rather than 0, so the
       fill reads 0% exactly where the bar appears and still reaches 100% at
       the document's end. Its own rule: animation-range folds into the
       shorthand too. */
    .fill {
      animation-timeline: scroll(root block);
      animation-range: 100dvh 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .progress,
    :global([data-past-hero]) .progress {
      transition: none;
    }
  }
</style>
