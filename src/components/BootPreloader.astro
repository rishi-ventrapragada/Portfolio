---
// Boot preloader (PRD §5.10). A square that fills in cell by cell as the page
// actually loads (BootSquare.astro), with a live percentage above it, shown
// once per browser session before the hero. Plain .astro plus one small script — no React
// state, so no island.
// The square is drawn from this site's own tokens. The backdrop is the same
// Starfield the hero mounts (PRD §5.14): identical build-time data and CSS
// animations started in the same first style pass, so when the overlay fades
// the sky behind it is the one already underneath — no seam, no second look.
import BootSquare from "./BootSquare.astro";
import Starfield from "./Starfield.astro";
import { statusFor } from "../scripts/boot-copy";
---

{/* Without JS nothing would ever remove the overlay, so hide it for no-JS
    visitors. PRD §8: the site works without JavaScript. */}
<noscript><style>.boot { display: none !important; }</style></noscript>

{/* aria-hidden: decorative. The real <h1> already carries the name. */}
<div class="boot" data-boot aria-hidden="true">
  <Starfield />

  <div class="boot-inner">
    {/* Live readout, directly above the square. Starts at 0% so the overlay is
        never blank in the frame before the script runs. */}
    <p class="boot-pct" data-pct>0%</p>

    <BootSquare />

    {/* Stage line, driven by the same step as the readout and the square.
        Rendered at stage 0 so it is never blank before the script runs. */}
    <p class="boot-status label" data-stage>{statusFor(0)}</p>
  </div>
</div>

{/* Synchronous and inline, straight after the overlay: this runs before the
    browser paints, so a repeat visit, a deep link or a reduced-motion visitor
    never sees a frame of the overlay. The deferred module below drives the
    sequence for everyone else. */}
<script is:inline>
  (() => {
    const el = document.querySelector("[data-boot]");
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem("boot-seen") === "1";
    } catch {
      /* sessionStorage unavailable — treat as unseen; it just replays. */
    }
    // A deep link (any URL with a fragment, including the redirected old
    // routes) lands mid-page, not on the hero. Without this the browser's own
    // fragment scroll trips the scroll skip a frame after first paint, and the
    // overlay flashes for one fade over a page that is still scrolling.
    if (seen || location.hash || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.remove();
      return;
    }
    // The grace cap's backstop, 4000ms from navigation start (increment 32).
    // The module below arms the real cap, but it is deferred until the whole
    // document has arrived — about 5s on slow 3G — so until it has started
    // (data-running) this fades the overlay out from wherever it stands.
    setTimeout(() => {
      if (!el.isConnected || el.hasAttribute("data-running")) return;
      try {
        sessionStorage.setItem("boot-seen", "1");
      } catch {
        /* Non-fatal: it may replay next load. */
      }
      el.setAttribute("data-out", "");
      setTimeout(() => el.remove(), 400);
    }, Math.max(0, 4000 - performance.now()));
  })();
</script>

<script>
  import { runBootSequence } from "../scripts/boot-preloader";

  // 2000ms dwell, paced on the fixed pause points in boot-schedule.ts (which
  // scale to it): an instant load still walks every step rather than
  // flashing, and the whole overlay is gone in ~2.4s with the fade
  // (increment 29 — the owner's call; 6000 since increment 11 read as a
  // wait). 4000ms grace cap, counted from navigation start (increment 32),
  // so a stalled resource can never strand the visitor for long.
  runBootSequence(2000, 4000);
</script>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    /* A full-screen transient moment, not page content: centred on both axes
       rather than following the site's left-margin convention. */
    place-items: center;
    padding: 0 var(--gutter);
    background-color: var(--bg);
    opacity: 1;
    transition: opacity 400ms ease;
  }

  .boot[data-out] {
    opacity: 0;
    pointer-events: none;
  }

  .boot-inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
  }

  .boot-pct {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--fg);
  }

  .boot-status {
    margin: 0;
    color: var(--fg-muted);
    text-align: center;
    /* Half of the stage cross-fade; the script swaps the text between the
       two halves. Keep in step with STATUS_FADE_MS in boot-status.ts. */
    transition: opacity 160ms ease;
  }

  .boot-status[data-fading] {
    opacity: 0;
  }

  /* --- Reduced motion: the script removes the overlay outright, so this is
     only a guard for the frame before the script runs. ------------------- */
  /* Belt and braces with the inline script above: reduced motion never paints
     the overlay even for the frame before script runs. */
  @media (prefers-reduced-motion: reduce) {
    .boot {
      display: none;
    }

    .boot-status {
      transition: none;
    }
  }
</style>
