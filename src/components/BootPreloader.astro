---
// Boot preloader (PRD §5.10). Word-cycling greeting shown once per browser
// session before the hero. Plain .astro plus one small script — no React state,
// so no island.
// Each cycling word has a fixed colour token (PRD §5.10); the tokens live in
// global.css beside the other design tokens.
const greetings = [
  { word: "Hello", tone: "amber" },
  { word: "Namaste", tone: "coral" },
  { word: "Bonjour", tone: "sky" },
  { word: "Hola", tone: "mint" },
  { word: "Ciao", tone: "periwinkle" },
];
const roles = [
  { word: "Developer", tone: "amber" },
  { word: "Video Editor", tone: "coral" },
  { word: "Problem Solver", tone: "sky" },
  { word: "Builder", tone: "mint" },
];
---

{/* Without JS nothing would ever remove the overlay, so hide it for no-JS
    visitors. PRD §8: the site works without JavaScript. */}
<noscript><style>.boot { display: none !important; }</style></noscript>

{/* aria-hidden: decorative. The real <h1> already carries the name. */}
<div class="boot" data-boot aria-hidden="true">
  {/* Lines are stacked in one grid cell so only one occupies the box at a
      time; the script shows exactly one at a time (PRD §5.10). */}
  <div class="boot-inner">
    {/* Two stacked rows in one slide: the greeting cycles above, the name is
        static below and visible from the start. No connector punctuation. */}
    <p class="boot-line boot-greeting" data-line="1" data-on>
      <span class="boot-row">
        <span class="cycler" data-cycle="greeting">
          {/* Words are stacked over an invisible grid cell holding all of them,
              so the box is as wide as the widest and never reflows on swap. */}
          {greetings.map(({ word, tone }, i) => (
            <span class="cycler-word" style={`--tone: var(--word-${tone})`} data-on={i === 0 ? "" : undefined}>{word}</span>
          ))}
          <span class="cycler-sizer" aria-hidden="true">
            {greetings.map(({ word }) => <span>{word}</span>)}
          </span>
        </span>
      </span>
      <span class="boot-row boot-name">I&rsquo;m Rishi</span>
    </p>

    <p class="boot-line boot-role" data-line="2">
      <span class="boot-tail">I am a&nbsp;</span><span class="cycler" data-cycle="role">
        {roles.map(({ word, tone }, i) => (
          <span class="cycler-word" style={`--tone: var(--word-${tone})`} data-on={i === 0 ? "" : undefined}>{word}</span>
        ))}
        <span class="cycler-sizer" aria-hidden="true">
          {roles.map(({ word }) => <span>{word}</span>)}
        </span>
      </span>
    </p>

    <p class="boot-status label" data-line="3">
      Website loading<span class="boot-dots" data-dots aria-hidden="true"></span>
    </p>
  </div>
</div>

{/* Synchronous and inline, straight after the overlay: this runs before the
    browser paints, so a repeat visit or reduced-motion visitor never sees a
    frame of the overlay. The deferred module below drives the sequence for
    everyone else. */}
<script is:inline>
  (() => {
    const el = document.querySelector("[data-boot]");
    if (!el) return;
    let seen = false;
    try {
      seen = sessionStorage.getItem("boot-seen") === "1";
    } catch {
      /* sessionStorage unavailable — treat as unseen; it just replays. */
    }
    if (seen || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.remove();
    }
  })();
</script>

<script>
  import { runBootSequence } from "../scripts/boot-preloader";

  // 5000ms per line, per PRD §5.10.
  runBootSequence(5000);
</script>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    /* A full-screen transient moment, not page content: centred on both axes
       rather than following the site's left-margin convention. */
    place-items: center;
    padding: 0 var(--gutter);
    background-color: var(--bg);
    opacity: 1;
    transition: opacity 400ms ease;
  }

  .boot[data-out] {
    opacity: 0;
    pointer-events: none;
  }

  .boot-inner {
    display: grid;
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
    /* Reserve the tallest line's height (line 1 is two rows at 1.2 line-height)
       so the block never jumps between slides. */
    min-height: 2.6em;
    align-content: center;
  }

  .boot-line {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 6vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .boot-greeting {
    font-weight: 700;
  }

  /* Line 1 is two rows: cycling greeting above, static name below. */
  .boot-row {
    display: block;
  }

  .boot-name {
    color: var(--fg);
  }

  .boot-role {
    font-weight: 500;
  }

  /* --- One line at a time -----------------------------------------------
     Every line sits in the same grid cell. The script gives exactly one the
     data-on attribute; the others are faded out and non-interactive. The
     line transition is deliberately slower and eased than the 150ms
     word swap inside a line (PRD 5.10). */
  .boot [data-line] {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.6em);
    transition:
      opacity 450ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 450ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .boot [data-line][data-on] {
    opacity: 1;
    transform: translateY(0);
  }

  /* Leaving lines travel up and out, so the sequence reads downward. */
  .boot [data-line][data-out] {
    opacity: 0;
    transform: translateY(-0.6em);
  }

  .boot-status {
    margin: 0;
    color: var(--fg-muted);
    text-align: center;
    /* Above --size-label (0.75rem): line 3 is the final beat of a full-screen
       moment, not a page label, and needs to hold its own under lines 1-2. */
    font-size: 0.9375rem;
  }

  .boot-dots {
    display: inline-block;
    /* Three mono glyphs at 0.6em advance each; reserved so the text above
       never shifts as the dots cycle. */
    min-width: 1.8em;
    text-align: left;
  }

  /* --- Word cycler ------------------------------------------------------
     Every word is absolutely positioned over an invisible sizer set to the
     longest word, so swapping words never reflows the line. */
  /* The sizer fixes this box to the widest word in the array, so the static
     text beside it never moves as words swap. On line 1 the cycler is its own
     centred row; on line 2 it follows "I am a", so it aligns left there to
     avoid a floating gap after the static text. */
  .cycler {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    text-align: center;
  }

  .boot-role .cycler {
    text-align: left;
  }

  /* Every word in one grid cell: the cell is as wide as the widest word. */
  .cycler-sizer {
    display: grid;
    visibility: hidden;
  }

  .cycler-sizer > span {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .cycler-word {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    /* Per-word colour, set inline from the palette tokens. The colour arrives
       and leaves with the word because the cross-fade is opacity-driven, so no
       separate colour animation is needed. */
    color: var(--tone, var(--fg));
    opacity: 0;
    transform: translateY(0.25em);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
    white-space: nowrap;
  }

  .cycler-word[data-on] {
    opacity: 1;
    transform: translateY(0);
  }

  .cycler-word[data-out] {
    opacity: 0;
    transform: translateY(-0.25em);
  }

  /* --- Reduced motion: the script removes the overlay outright, so this is
     only a guard for the frame before the script runs. ------------------- */
  /* Belt and braces with the inline script above: reduced motion never paints
     the overlay even for the frame before script runs. */
  @media (prefers-reduced-motion: reduce) {
    .boot {
      display: none;
    }
  }
</style>
