---
// The hero's role-and-school caption (PRD §5.2, increment 29): a quieter
// return of the caption layer increment 1.5 removed. Rendered by
// Wordmark.astro inside its .letters box, so it dissolves with the letters
// and is positioned against them. Split out for the CLAUDE.md §5 line cap.
// It sits on the sky, so it wears the .halo (utilities.css, increment 32).
---

<p class="label caption halo">CSE · Data Science · VJIT</p>

<style>
  /* On the letters' right edge, clear of the subject: under them from
     1024px, above them below that (under them the head covered 20–62% of
     it). Absolute, so it never moves the letters or the overlap maths. */
  .caption {
    position: absolute;
    top: 100%;
    right: 0;
    margin: 0.75rem 0 0;
    white-space: nowrap;
    color: var(--fg-muted);
  }

  @media (max-width: 1023.98px) and (min-height: 500px) {
    .caption {
      top: auto;
      bottom: 100%;
      margin: 0 0 0.75rem;
    }
  }

  /* Short landscape: letters at the nav floor, no sky above them, so the
     caption stays under them on the left edge, the side the head leaves. */
  @media (max-width: 1023.98px) and (max-height: 499.98px) {
    .caption {
      right: auto;
      left: 0;
    }
  }
</style>
