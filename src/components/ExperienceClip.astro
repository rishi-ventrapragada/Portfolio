---
// One clip on the Experience timeline's V1 track (PRD §5.11): a real button
// styled as a solid, textured NLE clip block. Split from ExperienceTrack.astro
// for the CLAUDE.md §5 line cap. The tone is one of the small palette tokens
// in global.css, passed in as a custom property.
interface Props {
  id: string;
  year: string;
  keyword: string;
  /** Token suffix: amber | sky | mint | periwinkle → `--word-<tone>`. */
  tone: string;
  pressed: boolean;
  /** Not shipped yet: the shared `.planned` utility dims and dashes it. */
  planned?: boolean;
}

const { id, year, keyword, tone, pressed, planned = false } = Astro.props;
---

{/* The visible labels are the accessible name (year + keyword); the verbatim
    sentence is the description via aria-describedby, so a screen reader
    hears both. Enter / Space are native. */}
<button
  type="button"
  class:list={["clip", { planned }]}
  style={`--tone: var(--word-${tone})`}
  data-clip={id}
  aria-pressed={pressed ? "true" : "false"}
  aria-describedby={`experience-${id}`}
>
  <span class="meta year">{year}</span>
  <span class="keyword">{keyword}</span>
</button>

<style>
  /* Solid block with a faint diagonal texture (currentColor = dark text on
     the tone). Layered so the shared, unlayered `.planned` utility in
     global.css wins its border-style and opacity without !important. */
  @layer components {
    .clip {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.75rem;
      min-width: 0;
      min-height: 4.5rem;
      padding: 0.5rem 0.625rem;
      overflow: hidden;
      color: var(--bg);
      text-align: left;
      background-color: var(--tone);
      border: 1px solid var(--timeline-bg);
      border-radius: 2px;
      cursor: pointer;
      transition:
        filter 160ms ease,
        box-shadow 160ms ease;
    }

    .clip::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: repeating-linear-gradient(-60deg, currentColor 0 1px, transparent 1px 5px);
      opacity: 0.14;
    }

    .clip:hover {
      filter: brightness(1.08);
    }

    /* Pressed = the site's active state, as an inset --accent ring. */
    .clip[aria-pressed="true"] {
      box-shadow: inset 0 0 0 2px var(--accent);
    }
  }

  .year {
    color: inherit;
    opacity: 0.8;
  }

  .keyword {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
  }

  @media (prefers-reduced-motion: reduce) {
    .clip {
      transition: none;
    }
  }
</style>
