---
// One clip on the Experience timeline's V1 track (PRD §5.11): a real button
// styled as a slim, solid NLE clip block with a one-line label. Split from
// ExperienceTrack.astro for the CLAUDE.md §5 line cap. The tone is one of
// the small palette tokens in global.css, passed in as a custom property.
interface Props {
  id: string;
  year: string;
  keyword: string;
  /** Token suffix: amber | sky | mint | periwinkle → `--word-<tone>`. */
  tone: string;
  pressed: boolean;
  /** Not shipped yet: the shared `.planned` utility dims and dashes it. */
  planned?: boolean;
}

const { id, year, keyword, tone, pressed, planned = false } = Astro.props;
---

{/* The visible labels are the accessible name (year + keyword); the verbatim
    sentence is the description via aria-describedby, so a screen reader
    hears both. Enter / Space are native. */}
<button
  type="button"
  class:list={["clip", { planned }]}
  style={`--tone: var(--word-${tone})`}
  data-clip={id}
  aria-pressed={pressed ? "true" : "false"}
  aria-describedby={`experience-${id}`}
>
  <span class="meta year">{year}</span>
  <span class="keyword">{keyword}</span>
</button>

<style>
  /* A 34px block with year and keyword on one line (two stacked lines do
     not fit legibly at this height): flat tone fill with a 2px darker edge
     along the bottom, the way NLE clips are drawn — no texture (increment
     14.1 tried a faint stripe as well; the flat fill read as software, the
     stripes as a sticker). Layered so the shared, unlayered `.planned`
     utility (utilities.css) wins its border-style without !important; the
     planned clip's own rule below then replaces the utility's fade. */
  @layer components {
    .clip {
      --edge: color-mix(in srgb, var(--tone) 65%, var(--timeline-bg));
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-width: 0;
      min-height: 2.125rem;
      padding: 0.25rem 0.5rem;
      overflow: hidden;
      color: var(--bg);
      white-space: nowrap;
      text-align: left;
      background-color: var(--tone);
      border: 1px solid var(--timeline-bg);
      border-radius: 2px;
      box-shadow: inset 0 -2px 0 var(--edge);
      cursor: pointer;
      transition:
        filter 160ms ease,
        box-shadow 160ms ease;
    }

    .clip:hover {
      filter: brightness(1.08);
    }

    /* Pressed = the site's active state, as an inset --accent ring with a
       2px --timeline-bg band inside it (increment 32): crimson on the tone
       fills measured only 1.9–2.0:1, under WCAG 1.4.11's 3:1, while the
       dark band separates the ring from every fill by far more. The band
       covers the bottom edge, so the edge shadow is gone while pressed. */
    .clip[aria-pressed="true"] {
      box-shadow:
        inset 0 0 0 2px var(--accent),
        inset 0 0 0 4px var(--timeline-bg);
    }
  }

  /* Planned (Recurzn): the fill steps back and the ink flips, instead of
     the shared utility's 0.5 opacity on the whole clip — that took the dark
     ink to 2.87:1 ("Recurzn") and 2.48:1 ("Now"), under AA (increment 28).
     The fill is exactly what the fade used to composite to (the tone half
     into --timeline-bg), so the block reads the same; --fg on it is
     measured in SESSION.md. The dashed edge takes the tone so it shows —
     in --timeline-bg it was invisible against the lane. Unlayered and
     scoped, so it outranks the utility. */
  .clip.planned {
    opacity: 1;
    color: var(--fg);
    background-color: color-mix(in srgb, var(--tone) 50%, var(--timeline-bg));
    border-color: var(--tone);
  }

  /* Its fill is dark, so the band inside the pressed ring is the light ink
     instead (the dark one measured 2.91:1 against it). */
  .clip.planned[aria-pressed="true"] {
    box-shadow:
      inset 0 0 0 2px var(--accent),
      inset 0 0 0 4px var(--fg);
  }

  .year {
    flex: none;
    font-size: 0.625rem;
    color: inherit;
    opacity: 0.8;
  }

  .keyword {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .clip {
      transition: none;
    }
  }

  /* Forced colours (Windows High Contrast) drop every box-shadow, which
     left the four clips identical (increment 32): the pressed one gets a
     3px border in the system highlight instead, its padding 2px smaller so
     the label does not move. A border, not an outline: the focus ring is
     the outline, and a focused clip is always the pressed one. */
  @media (forced-colors: active) {
    .clip[aria-pressed="true"] {
      padding: calc(0.25rem - 2px) calc(0.5rem - 2px);
      border: 3px solid Highlight;
    }
  }
</style>
