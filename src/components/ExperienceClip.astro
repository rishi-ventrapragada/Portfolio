---
// One clip on the Experience timeline's V1 track (PRD §5.11): a real button
// styled as a slim, solid NLE clip block with a one-line label. Split from
// ExperienceTrack.astro for the CLAUDE.md §5 line cap. The tone is one of
// the small palette tokens in global.css, passed in as a custom property.
interface Props {
  id: string;
  year: string;
  keyword: string;
  /** Token suffix: amber | sky | mint | periwinkle → `--word-<tone>`. */
  tone: string;
  pressed: boolean;
  /** Not shipped yet: the shared `.planned` utility dims and dashes it. */
  planned?: boolean;
}

const { id, year, keyword, tone, pressed, planned = false } = Astro.props;
---

{/* The visible labels are the accessible name (year + keyword); the verbatim
    sentence is the description via aria-describedby, so a screen reader
    hears both. Enter / Space are native. */}
<button
  type="button"
  class:list={["clip", { planned }]}
  style={`--tone: var(--word-${tone})`}
  data-clip={id}
  aria-pressed={pressed ? "true" : "false"}
  aria-describedby={`experience-${id}`}
>
  <span class="meta year">{year}</span>
  <span class="keyword">{keyword}</span>
</button>

<style>
  /* A 34px block with year and keyword on one line (two stacked lines do
     not fit legibly at this height): flat tone fill with a 2px darker edge
     along the bottom, the way NLE clips are drawn — no texture (increment
     14.1 tried a faint stripe as well; the flat fill read as software, the
     stripes as a sticker). Layered so the shared, unlayered `.planned`
     utility in global.css wins its border-style and opacity without
     !important. */
  @layer components {
    .clip {
      --edge: color-mix(in srgb, var(--tone) 65%, var(--timeline-bg));
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      min-width: 0;
      min-height: 2.125rem;
      padding: 0.25rem 0.5rem;
      overflow: hidden;
      color: var(--bg);
      white-space: nowrap;
      text-align: left;
      background-color: var(--tone);
      border: 1px solid var(--timeline-bg);
      border-radius: 2px;
      box-shadow: inset 0 -2px 0 var(--edge);
      cursor: pointer;
      transition:
        filter 160ms ease,
        box-shadow 160ms ease;
    }

    .clip:hover {
      filter: brightness(1.08);
    }

    /* Pressed = the site's active state, as an inset --accent ring over
       the bottom edge. */
    .clip[aria-pressed="true"] {
      box-shadow:
        inset 0 0 0 2px var(--accent),
        inset 0 -2px 0 var(--edge);
    }
  }

  .year {
    flex: none;
    font-size: 0.625rem;
    color: inherit;
    opacity: 0.8;
  }

  .keyword {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .clip {
      transition: none;
    }
  }
</style>
