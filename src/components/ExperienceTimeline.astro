---
// Experience section (PRD §5.11): an NLE-style monitor above a timeline of
// clip buttons. Each clip is one moment; the monitor shows the committed one.
// Body sentences are the owner's, verbatim. Clip keywords are words taken
// from those sentences, not new copy. KalaCart's cover is the projects
// collection's real screenshot, reused through <Image> — no new asset.
// One frame = ExperienceFrame.astro; ruler, tracks and playhead =
// ExperienceTrack.astro (split for the CLAUDE.md §5 line cap); behaviour =
// scripts/experience-timeline.ts. Only the heading block sits in the shell:
// the monitor and the timeline run viewport edge to edge, like an editor.
import { getEntry } from "astro:content";
import ExperienceFrame from "./ExperienceFrame.astro";
import ExperienceTrack from "./ExperienceTrack.astro";

const kalacart = await getEntry("projects", "kalacart");
if (!kalacart) throw new Error("projects/kalacart is missing");

interface Moment {
  id: string;
  /** Shown in the monitor and as the first half of the clip label. */
  year: string;
  /** One word from the sentence; the clip reads `${year} ${keyword}`. */
  keyword: string;
  body: string;
  /** Not shipped yet: the clip takes the shared `.planned` treatment. */
  planned?: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const moments: Moment[] = [
  { id: "web", year: "2025", keyword: "JavaScript", body: "2025 — Learnt C, HTML, CSS and JavaScript" },
  { id: "python", year: "2025", keyword: "Python", body: "2025 — Learnt Python and MySQL" },
  {
    id: "kalacart",
    year: "2026",
    keyword: "KalaCart",
    body: "2026 — Built KalaCart: AI Market Linkage for Artisans",
    cover: kalacart.data.cover,
    coverAlt: `${kalacart.data.title} project cover`,
  },
  {
    id: "recurzn",
    year: "Now",
    keyword: "Recurzn",
    body: "2026 — Building Recurzn, a cross-platform Self-Improvement App",
    planned: true,
  },
];
---

<section class="experience" id="experience" aria-labelledby="experience-heading" data-experience>
  <div class="shell">
    <p class="label eyebrow">Journey</p>
    <h2 id="experience-heading" class="heading">Experience</h2>
  </div>

  {/* A fixed-height black screen. Every frame is in the HTML, stacked in
      one grid cell, so a swap is a cross-fade inside a box that never
      changes size. The first is active from the server, so the section
      reads without JavaScript. */}
  <div class="monitor" data-monitor>
    {moments.map((moment, i) => <ExperienceFrame {...moment} index={i} active={i === 0} />)}
  </div>

  <ExperienceTrack moments={moments} />
</section>

<script>
  import { initExperience } from "../scripts/experience-timeline";

  const root = document.querySelector<HTMLElement>("[data-experience]");
  if (root) initExperience(root);
</script>

<style>
  .experience {
    padding-block: var(--rhythm);
    border-top: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .heading {
    margin: 0 0 2rem;
    font-size: var(--size-h2);
  }

  /* The frames (ExperienceFrame.astro) all take grid-area 1 / 1 here.
     --monitor-bg is the site's one pure-black surface (PRD §4.2). */
  .monitor {
    display: grid;
    height: 60vh;
    min-height: 340px;
    overflow: hidden;
    background-color: var(--monitor-bg);
  }
</style>
