---
// Experience section (PRD §5.11): a scroll track whose sticky pin holds an
// NLE-style monitor — the heading in its top-left corner since increment
// 33 — and its timeline.
// Scrolling the track scrubs the timeline (scripts/experience-scrub.ts);
// click, keyboard and hover still work (scripts/experience-timeline.ts).
// Each clip is one moment; the monitor shows the committed one. Body
// sentences are the owner's, verbatim, without the year the label above
// already shows; the first two openings are the owner's picks from
// alternatives offered in increment 33 (both began "Learnt"). Clip keywords are words taken from
// those sentences, not new copy. KalaCart's cover is the projects
// collection's real screenshot, reused through <Image> — no new asset. One
// frame = ExperienceFrame.astro; ruler, tracks and playhead =
// ExperienceTrack.astro; the heading = ExperienceHead.astro. Only the
// heading's text sits in the shell: the monitor and the timeline run
// viewport edge to edge. No Starfield (increment 33 removed increment 24's).
import { getEntry } from "astro:content";
import ExperienceFrame from "./ExperienceFrame.astro";
import ExperienceHead from "./ExperienceHead.astro";
import ExperienceTrack from "./ExperienceTrack.astro";

const kalacart = await getEntry("projects", "kalacart");
if (!kalacart) throw new Error("projects/kalacart is missing");

interface Moment {
  id: string;
  /** Shown in the monitor and as the first half of the clip label. */
  year: string;
  /** One word from the sentence; the clip reads `${year} ${keyword}`. */
  keyword: string;
  body: string;
  /** Not shipped yet: the clip takes the shared `.planned` treatment. */
  planned?: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const moments: Moment[] = [
  { id: "web", year: "2025", keyword: "JavaScript", body: "Started with C, HTML, CSS and JavaScript" },
  { id: "python", year: "2025", keyword: "Python", body: "Moved on to Python and MySQL" },
  {
    id: "kalacart",
    year: "2026",
    keyword: "KalaCart",
    body: "Built KalaCart: AI Market Linkage for Artisans",
    cover: kalacart.data.cover,
    coverAlt: `${kalacart.data.title} project cover`,
  },
  {
    id: "recurzn",
    year: "2026",
    keyword: "Recurzn",
    body: "Building Recurzn, a cross-platform Self-Improvement App",
    planned: true,
  },
];
---

<section class="experience" id="experience" aria-labelledby="experience-heading" data-experience>
  {/* Without JavaScript nothing maps scroll to clips, so the <noscript>
      style (the BootPreloader.astro pattern) makes the track a normal
      content-height block with the increment-13.1 monitor height; flex:
      none, or the flex basis would override that height. Short screens
      get the same layout from the media query in the <style> below. */}
  <noscript>
    <style>
      [data-scrub] { height: auto !important; }
      [data-pin] { position: static !important; height: auto !important; }
      [data-monitor] { flex: none !important; height: 60vh !important; min-height: 400px !important; }
    </style>
  </noscript>

  {/* The scroll track; .pin sticks inside it for the whole distance (the
      Wordmark.astro technique) and holds the monitor and the timeline. */}
  <div class="scrub" data-scrub>
    <div class="pin" data-pin>
      {/* A black monitor filling the pinned viewport above the timeline:
          the heading in its corner (increment 33 — it was a band of its own
          above the monitor, on a sky), then the screen. Every frame is in
          the HTML, stacked in the screen's one grid cell, so a swap is a
          cross-fade inside a box that never changes size. The first is
          active from the server, so the section reads without JavaScript. */}
      <div class="monitor" data-monitor>
        <ExperienceHead />
        <div class="screen" data-screen>
          {moments.map((moment, i) => <ExperienceFrame {...moment} index={i} active={i === 0} />)}
        </div>
      </div>

      <div class="track-slot">
        <ExperienceTrack moments={moments} />
      </div>
    </div>
  </div>
</section>

<script>
  import { initExperience } from "../scripts/experience-timeline";

  const root = document.querySelector<HTMLElement>("[data-experience]");
  if (root) initExperience(root);
</script>

<style>
  /* The section starts at the pin now, so an anchor jump lands with the pin
     already stuck on the first clip: no nav allowance (the pin clears the
     bar itself, below). */
  .experience {
    scroll-margin-top: 0;
  }

  /* --pin-length is the one number to tune: the scroll distance the track
     occupies. The pin travels (--pin-length − 100dvh); each of the four clip
     zones is a quarter of that. */
  .scrub {
    --pin-length: 250vh;
    height: var(--pin-length);
  }

  /* The full viewport; its top padding clears the fixed nav, which is
     opaque past the hero (the heading band carried it until increment 33).
     The strip behind the bar is the monitor's black, so no page ground
     shows between them. */
  .pin {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    height: 100dvh;
    padding-top: var(--nav-height);
    background-color: var(--monitor-bg);
  }

  /* --monitor-bg is the site's one pure-black surface (PRD §4.2): the
     heading (ExperienceHead.astro), then the screen. */
  .monitor {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    background-color: var(--monitor-bg);
  }

  /* The frames (ExperienceFrame.astro) all take grid-area 1 / 1 here and
     size their cover in cqh against this box, hence the size container. */
  .screen {
    flex: 1;
    display: grid;
    min-height: 0;
    container-type: size;
  }

  .track-slot {
    flex: none;
  }

  /* Short screens (increment 32): below the height every frame needs, the
     monitor clipped its sentence (0px tall at 400% zoom), so the section
     takes the no-JS layout above — in flow, a 60vh / 400px monitor (340
     before the heading moved into it), the clips still commit on click and
     focus. Each band's number is one step above the tallest failing
     height, scanned every 4px with the pin forced on (increment 33): 512
     below 480px wide, 444 to 767, 348 from 768 — re-measured in
     increment 34 (PRD §5.11: 31px spare at 348, none clipped down to
     300px), and kept with no extra margin by the owner's call. The
     heading band and its sky gone, the monitor has far more room than in
     increment 32 (532 / 464 / 524 / 576). experience-scrub.ts reads the
     pin's position and stands down while it is static. */
  @media (max-height: 347.98px),
    (max-height: 511.98px) and (max-width: 479.98px),
    (max-height: 443.98px) and (max-width: 767.98px) {
    .scrub {
      height: auto;
    }

    .pin {
      position: static;
      height: auto;
    }

    .monitor {
      flex: none;
      height: 60vh;
      min-height: 400px;
    }
  }
</style>
