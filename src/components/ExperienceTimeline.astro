---
// Experience section (PRD §5.11): an NLE-style monitor above a timeline of
// clip buttons, pinned while the page scrolls through it. Scrolling scrubs
// the timeline (scripts/experience-scrub.ts); click, keyboard and hover
// still work (scripts/experience-timeline.ts). Each clip is one moment; the
// monitor shows the committed one. Body sentences are the owner's, verbatim.
// Clip keywords are words taken from those sentences, not new copy.
// KalaCart's cover is the projects collection's real screenshot, reused
// through <Image> — no new asset. One frame = ExperienceFrame.astro; ruler,
// tracks and playhead = ExperienceTrack.astro. Only the heading block sits
// in the shell: the monitor and the timeline run viewport edge to edge.
import { getEntry } from "astro:content";
import ExperienceFrame from "./ExperienceFrame.astro";
import ExperienceTrack from "./ExperienceTrack.astro";

const kalacart = await getEntry("projects", "kalacart");
if (!kalacart) throw new Error("projects/kalacart is missing");

interface Moment {
  id: string;
  /** Shown in the monitor and as the first half of the clip label. */
  year: string;
  /** One word from the sentence; the clip reads `${year} ${keyword}`. */
  keyword: string;
  body: string;
  /** Not shipped yet: the clip takes the shared `.planned` treatment. */
  planned?: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const moments: Moment[] = [
  { id: "web", year: "2025", keyword: "JavaScript", body: "2025 — Learnt C, HTML, CSS and JavaScript" },
  { id: "python", year: "2025", keyword: "Python", body: "2025 — Learnt Python and MySQL" },
  {
    id: "kalacart",
    year: "2026",
    keyword: "KalaCart",
    body: "2026 — Built KalaCart: AI Market Linkage for Artisans",
    cover: kalacart.data.cover,
    coverAlt: `${kalacart.data.title} project cover`,
  },
  {
    id: "recurzn",
    year: "Now",
    keyword: "Recurzn",
    body: "2026 — Building Recurzn, a cross-platform Self-Improvement App",
    planned: true,
  },
];
---

{/* The section is the tall scroll track; .pin sticks inside it for the
    whole distance (the Wordmark.astro technique). Without JavaScript nothing
    maps scroll to clips, so the <noscript> style makes it a normal
    content-height block instead (the BootPreloader.astro pattern). */}
<section class="experience" id="experience" aria-labelledby="experience-heading" data-experience>
  <noscript>
    <style>
      [data-experience] { height: auto !important; }
      [data-pin] { position: static !important; height: auto !important; }
      /* A size container has no intrinsic height, so give the monitor the
         increment-13.1 fixed height when nothing pins it (flex: none, or the
         flex basis would override the height). */
      [data-monitor] { flex: none !important; height: 60vh !important; min-height: 340px !important; }
    </style>
  </noscript>
  <div class="pin" data-pin>
    <div class="shell head">
      <p class="label eyebrow">Journey</p>
      <h2 id="experience-heading" class="heading">Experience</h2>
    </div>

    {/* A black screen filling the pinned viewport between heading and
        timeline. Every frame is in the HTML, stacked in one grid cell, so a
        swap is a cross-fade inside a box that never changes size. The first
        is active from the server, so the section reads without JavaScript. */}
    <div class="monitor" data-monitor>
      {moments.map((moment, i) => <ExperienceFrame {...moment} index={i} active={i === 0} />)}
    </div>

    <div class="track-slot">
      <ExperienceTrack moments={moments} />
    </div>
  </div>
</section>

<script>
  import { initExperience } from "../scripts/experience-timeline";

  const root = document.querySelector<HTMLElement>("[data-experience]");
  if (root) initExperience(root);
</script>

<style>
  /* --pin-length is the one number to tune: the scroll distance the section
     occupies. The pin travels (--pin-length − 100dvh); each of the four clip
     zones is a quarter of that. The anchor lands on the pin start (progress
     0 = first clip); the pin pads for the fixed nav itself. */
  .experience {
    --pin-length: 250vh;
    height: var(--pin-length);
    border-top: 1px solid var(--line);
    scroll-margin-top: 0;
  }

  .pin {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    height: 100dvh;
    padding-top: var(--nav-height);
  }

  /* width: 100% so the shell's auto side margins have no free space to
     absorb; as a bare flex item it would shrink-wrap and centre. */
  .head {
    flex: none;
    width: 100%;
    padding-top: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
  }

  .heading {
    margin: 0 0 1.25rem;
    font-size: var(--size-h2);
  }

  /* The frames (ExperienceFrame.astro) all take grid-area 1 / 1 here and
     size their cover in cqh against this box, hence the size container.
     --monitor-bg is the site's one pure-black surface (PRD §4.2). */
  .monitor {
    flex: 1;
    display: grid;
    min-height: 0;
    overflow: hidden;
    container-type: size;
    background-color: var(--monitor-bg);
  }

  .track-slot {
    flex: none;
  }
</style>
