---
// Project card (PRD §5.3). One per collection entry. There is no case study to
// open, so the title is plain text and the links row is the only way out of
// the card. `status` is never printed: it only dims a planned entry.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Pills from "./Pills.astro";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, summary, stack, status, year, links, cover } = entry.data;

// A link value may hold a visibly marked "[TODO]" placeholder (CLAUDE.md §7),
// which must never become an href. Only real URLs render as links; anything
// else renders as text so the placeholder stays visible.
const isUrl = (value?: string) => !!value && /^https?:\/\//.test(value);
const linkRows = [
  { label: "Live site", value: links?.live },
  { label: "GitHub", value: links?.repo },
].filter((row) => row.value);
---

<article class="card" data-status={status}>
  <div class="cover">
    <Image
      src={cover}
      alt={`${title} project cover`}
      widths={[636, 1272]}
      sizes="(min-width: 768px) 700px, 92vw"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="body">
    {/* h3: the section owns the h2 and the hero owns the page's only h1.
        Title and year on one line; there is no status eyebrow (PRD §5.3). */}
    <h3 class="title">
      {title}
      {year !== undefined && <span class="year">{` · ${year}`}</span>}
    </h3>
    {summary && <p class="summary">{summary}</p>}
    {stack && <Pills items={stack} label="Stack" />}

    {
      linkRows.length > 0 && (
        <ul class="links">
          {linkRows.map(({ label, value }) =>
            isUrl(value) ? (
              <li>
                <a class="label link" href={value} rel="noopener">
                  {label}
                </a>
              </li>
            ) : (
              <li class="meta pending">
                {label} &mdash; {value}
              </li>
            ),
          )}
        </ul>
      )
    }
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: 1.5rem;
    background-color: var(--bg-raised);
    border: 1px solid var(--line);
  }

  /* Planned: not shipped yet, so the whole card steps back (PRD §5.3). */
  .card[data-status="planned"] {
    opacity: 0.5;
  }

  .cover {
    overflow: hidden;
  }

  /* The cover is a screenshot, so it sets its own ratio rather than being
     cropped: a forced box would clip UI chrome, which reads as a mistake on a
     screenshot in a way it would not on a photo. */
  .cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .title {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .year {
    color: var(--fg-muted);
    font-weight: 500;
  }

  .summary {
    margin: 0;
    max-width: 60ch;
    color: var(--fg);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .link {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--fg);
    border-bottom: 1px solid var(--line);
    transition:
      color 160ms ease,
      border-color 160ms ease;
  }

  .link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .pending {
    align-self: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .link {
      transition: none;
    }
  }
</style>
