---
// Sticky table of contents for a case study (PRD §5.5).
// Headings come from Astro's render(), so the list is generated from the real
// document at build time — no hardcoded section names, no client JS. Astro
// injects matching `id` attributes on the rendered headings, so the anchors
// resolve without extra work.
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Top-level sections only; deeper headings would make the list noisy.
const sections = headings.filter((heading) => heading.depth === 2);
---

{
  sections.length > 0 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <p id="toc-heading" class="label toc-title">
        On this page
      </p>
      <ol class="toc-list">
        {sections.map((heading) => (
          <li>
            <a class="meta toc-link" href={`#${heading.slug}`}>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  /* A sticky table of contents earns its space only when there is a column to
     put it in. Below the desktop breakpoint it would just be a second list of
     links above the prose, so it is hidden and the meta panel stands alone. */
  .toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc {
      display: block;
    }
  }

  .toc-title {
    margin: 0 0 0.75rem;
    color: var(--fg-muted);
  }

  .toc-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-link {
    color: var(--fg);
  }

  .toc-link:hover {
    color: var(--accent);
  }
</style>
