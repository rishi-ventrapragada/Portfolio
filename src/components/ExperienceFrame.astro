---
// One monitor frame of the Experience section (PRD §5.11): year, keyword
// title, the owner's verbatim sentence and, when the moment has one, its
// cover. Stacked with its siblings in ExperienceTimeline's fixed-height
// monitor; `data-active` (set by the server for the first, then by the
// script) decides which one is visible. The timecode is decoration only.
import { Image } from "astro:assets";

interface Props {
  id: string;
  index: number;
  year: string;
  keyword: string;
  body: string;
  active?: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { id, index, year, keyword, body, active = false, cover, coverAlt } = Astro.props;
const timecode = `00:00:${String(index * 15).padStart(2, "0")}:00`;
---

<article
  class="frame"
  data-frame={id}
  data-active={active ? "" : undefined}
  data-cover={cover ? "" : undefined}
>
  <div class="inner">
    <div class="text">
      <p class="meta year">{year}</p>
      <h3 class="title">{keyword}</h3>
      {/* The id is the clip's aria-describedby target. */}
      <p class="body" id={`experience-${id}`}>{body}</p>
    </div>
    {
      cover && (
        <div class="cover">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={[636, 1272]}
            sizes="(min-width: 768px) 560px, 92vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </div>
  <span class="meta timecode" aria-hidden="true">{timecode}</span>
</article>

<style>
  /* Cross-fade: the leaving frame fades, then drops out of the tree
     (visibility flips after the opacity transition); the entering frame
     becomes visible at once and fades in. Hidden frames are out of the
     accessibility tree, so only the active one is read. */
  .frame {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    place-items: center;
    padding: 2rem var(--gutter) 3rem;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      visibility 0s linear 180ms;
  }

  .frame[data-active] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .inner {
    display: grid;
    gap: 1.5rem;
    width: min(100%, 64rem);
  }

  @media (min-width: 768px) {
    .frame[data-cover] .inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
      gap: 3rem;
    }
  }

  .text {
    display: grid;
    gap: 0.75rem;
    align-content: center;
  }

  .year,
  .title,
  .body {
    margin: 0;
  }

  .title {
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .body {
    max-width: 44ch;
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    color: var(--fg);
  }

  /* Never taller than the monitor: width follows the column, height is
     capped, and the WebP keeps its ratio inside that box. */
  .cover img {
    display: block;
    width: auto;
    max-width: min(100%, 560px);
    height: auto;
    max-height: 30vh;
    margin-inline: auto;
    object-fit: contain;
  }

  .timecode {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
  }

  /* Instant swap, no fade (CLAUDE.md §4). */
  @media (prefers-reduced-motion: reduce) {
    .frame {
      transition: none;
    }
  }
</style>
