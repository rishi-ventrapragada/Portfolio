---
// One monitor frame of the Experience section (PRD §5.11): year, keyword
// title, the owner's verbatim sentence and, when the moment has one, its
// cover. Stacked with its siblings in ExperienceTimeline's monitor grid;
// `data-active` (set by the server for the first, then by the script)
// decides which one is visible.
import { Image } from "astro:assets";

interface Props {
  id: string;
  year: string;
  keyword: string;
  body: string;
  active?: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { id, year, keyword, body, active = false, cover, coverAlt } = Astro.props;
---

<article
  class="frame"
  data-frame={id}
  data-active={active ? "" : undefined}
  data-cover={cover ? "" : undefined}
>
  <div class="text">
    <p class="meta year">{year}</p>
    <h3 class="title">{keyword}</h3>
    {/* The id is the clip's aria-describedby target. */}
    <p class="body" id={`experience-${id}`}>{body}</p>
  </div>
  {
    cover && (
      <div class="cover">
        <Image
          src={cover}
          alt={coverAlt ?? ""}
          widths={[636, 1272]}
          sizes="(min-width: 768px) 480px, 92vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</article>

<style>
  /* Cross-fade: the leaving frame fades, then drops out of the tree
     (visibility flips after the opacity transition); the entering frame
     becomes visible at once and fades in. Hidden frames are out of the
     accessibility tree, so only the active one is read. */
  .frame {
    grid-area: 1 / 1;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      visibility 0s linear 180ms;
  }

  .frame[data-active] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  @media (min-width: 768px) {
    .frame[data-cover] {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
      gap: 2.5rem;
    }
  }

  .text {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .year {
    margin: 0;
  }

  .title {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .body {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--fg);
  }

  /* Instant swap, no fade (CLAUDE.md §4). */
  @media (prefers-reduced-motion: reduce) {
    .frame {
      transition: none;
    }
  }
</style>
