---
// One monitor frame of the Experience section (PRD §5.11): a small year
// label, the owner's verbatim sentence as the dominant text and, when the
// moment has one, its cover. The keyword is the clip's label on the track
// below, not a heading here (increment 14.1). Stacked with its siblings in ExperienceTimeline's fixed-height
// monitor; `data-active` (set by the server for the first, then by the
// script) decides which one is visible. The timecode is decoration only.
import { Image } from "astro:assets";

interface Props {
  id: string;
  index: number;
  year: string;
  /** Rendered only by the clip button; accepted so the moment can be spread in. */
  keyword?: string;
  body: string;
  active?: boolean;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { id, index, year, body, active = false, cover, coverAlt } = Astro.props;
const timecode = `00:00:${String(index * 15).padStart(2, "0")}:00`;
---

<article
  class="frame"
  data-frame={id}
  data-active={active ? "" : undefined}
  data-cover={cover ? "" : undefined}
>
  <div class="inner">
    <div class="text">
      <p class="meta year">{year}</p>
      {/* The id is the clip's aria-describedby target. */}
      <p class="body" id={`experience-${id}`}>{body}</p>
    </div>
    {
      cover && (
        <div class="cover">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={[636, 1272]}
            sizes="(min-width: 768px) 560px, 92vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </div>
  <span class="meta timecode" aria-hidden="true">{timecode}</span>
</article>

<style>
  /* Cross-fade: the leaving frame fades, then drops out of the tree
     (visibility flips after the opacity transition); the entering frame
     becomes visible at once and fades in. Hidden frames are out of the
     accessibility tree, so only the active one is read. */
  .frame {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    place-items: center;
    padding: 1rem var(--gutter) 2.5rem;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      visibility 0s linear 180ms;
  }

  .frame[data-active] {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .inner {
    display: grid;
    gap: 1rem;
    width: min(100%, 64rem);
  }

  @media (min-width: 768px) {
    .frame {
      padding-block: 2rem 3rem;
    }

    .inner {
      gap: 1.5rem;
    }

    .frame[data-cover] .inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: center;
      gap: 3rem;
    }
  }

  .text {
    display: grid;
    gap: 0.75rem;
    align-content: center;
  }

  .year,
  .body {
    margin: 0;
  }

  /* The sentence is the frame's primary content, so it takes the display
     face at heading size; it stays a paragraph, not a heading. */
  .body {
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--fg);
  }

  /* Never taller than the monitor: the cap is in cqh of the monitor (a
     size container in ExperienceTimeline.astro), so it holds on a 300px
     phone monitor as well as a 540px desktop one; the WebP keeps its
     ratio inside that box. Stacked under the text it gets 36% of the
     height, beside the text from 768px it gets 70%. */
  .cover img {
    display: block;
    width: auto;
    max-width: min(100%, 560px);
    height: auto;
    max-height: 36cqh;
    margin-inline: auto;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .cover img {
      max-height: 70cqh;
    }
  }

  .timecode {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
  }

  /* Instant swap, no fade (CLAUDE.md §4). */
  @media (prefers-reduced-motion: reduce) {
    .frame {
      transition: none;
    }
  }
</style>
