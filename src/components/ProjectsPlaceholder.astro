---
// Stands in for the project tiles (PRD 5.3, increment 2).
---

<section class="projects shell" aria-labelledby="projects-heading">
  <p class="label eyebrow">Selected work</p>
  <h2 id="projects-heading" class="heading">Projects &mdash; coming soon</h2>
  <p class="meta note">Case studies in progress</p>
</section>

<style>
  .projects {
    padding-block: var(--rhythm);
    border-top: 1px solid var(--line);
  }

  .eyebrow {
    color: var(--accent);
    margin: 0 0 1rem;
  }

  .heading {
    font-size: var(--size-h2);
    margin: 0 0 1rem;
  }

  .note {
    margin: 0;
  }
</style>
