---
// Projects section (PRD §5.3): a film-strip contact sheet. Reads the
// collection, so adding an entry is the only work needed to add a frame.
// `id="projects"` is the nav and skills anchor; the heading keeps its own id
// for aria-labelledby. One frame = ProjectFrame.astro.
import { getCollection } from "astro:content";
import ProjectFrame from "./ProjectFrame.astro";

// Loader order is not `order`, so sort explicitly.
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<section class="projects shell" id="projects" aria-labelledby="projects-heading">
  <p class="label eyebrow">Selected work</p>
  <h2 id="projects-heading" class="heading">Projects</h2>

  {/* auto-fill, not auto-fit: frames keep their slot size and a later entry
      drops into the next empty slot, like a contact sheet. */}
  <div class="sheet">
    {projects.map((entry, i) => <ProjectFrame entry={entry} index={i} />)}
  </div>
</section>

<style>
  .projects {
    padding-block: var(--rhythm);
    border-top: 1px solid var(--line);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
  }

  .heading {
    margin: 0 0 2rem;
    font-size: var(--size-h2);
  }

  .sheet {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
