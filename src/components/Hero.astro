---
// Hero (PRD §5.2): 100dvh, two layers in one grid cell. Layer A, the wordmark
// and its scroll dissolve, lives in Wordmark.astro (split for the CLAUDE.md §5
// line cap). This file owns the section and Layer B, the subject cutout.
import { Image } from "astro:assets";
import heroSubject from "../assets/hero-subject.png";
import Wordmark from "./Wordmark.astro";
---

<section class="hero">
  <Wordmark />

  {/* Layer B — real cutout, bottom-anchored, LCP element.
      The PNG's own bottom ~4% fades to transparent, so it dissolves into the
      page instead of showing a cut edge. */}
  <div class="subject">
    <Image
      src={heroSubject}
      alt="Sai Rishi Ventrapragada"
      widths={[470, 923]}
      sizes="(min-width: 768px) 470px, 88vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100dvh;
    overflow: clip;
    background-color: var(--bg);
  }

  /* --- Layer B: subject -------------------------------------------------- */
  .subject {
    position: relative;
    z-index: 2;
    grid-area: 1 / 1;
    align-self: end;
    justify-self: center;
    /* Sized so the head and shoulders cross the lower half of the letters
       rather than riding up over the whole wordmark. */
    width: min(88vw, 470px);
  }

  /* Bottom-anchored. The PNG's built-in fade lands at the hero's bottom edge,
     so nothing below the vest reads as a cut. */
  .subject :global(img) {
    width: 100%;
    height: auto;
    max-height: 86dvh;
    object-fit: contain;
    object-position: bottom center;
  }

  /* Same 640px breakpoint as the wordmark's near-full-bleed switch: a taller
     subject so the shoulders still reach up into the short mobile letters. */
  @media (max-width: 639px) {
    .subject {
      width: 88vw;
    }

    .subject :global(img) {
      max-height: 82dvh;
    }
  }
</style>
