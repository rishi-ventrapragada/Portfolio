---
// Hero (PRD §5.2): 100dvh, two layers in one grid cell. Layer A, the wordmark
// and its scroll dissolve, lives in Wordmark.astro (split for the CLAUDE.md §5
// line cap). This file owns the section and Layer B, the subject cutout. Its
// widths and sizes come from lib/hero-image.ts, which the head's preload
// shares, so both name the same files.
import { Picture } from "astro:assets";
import heroSubject from "../assets/hero-subject.png";
import { heroFormats, heroRatio, heroSizes, heroWidths } from "../lib/hero-image";
import Starfield from "./Starfield.astro";
import Wordmark from "./Wordmark.astro";
---

{/* data-hero, not an id: every [id] inherits a 5rem scroll-margin from
    global.css, and nothing links here (the nav mark uses `#top`). The nav
    observes this box to hide its progress bar over the hero (PRD §5.1). */}
<section class="hero" data-hero style={`--subject-ratio: ${heroRatio.toFixed(4)}`}>
  {/* Meteors fly only below the letters and their caption (increment 32),
      behind the subject; the lane's top is the letters' box, below. */}
  <Starfield meteorTop="calc(var(--letters-top) + var(--wm-h) + 3rem)" />

  <Wordmark />

  {/* Layer B — real cutout, bottom-anchored, LCP element.
      The PNG's own bottom ~4% fades to transparent, so it dissolves into the
      page instead of showing a cut edge. */}
  <div class="subject">
    <Picture
      src={heroSubject}
      alt="Sai Rishi Ventrapragada"
      formats={[...heroFormats]}
      fallbackFormat="webp"
      widths={heroWidths}
      sizes={heroSizes}
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>
</section>

<style>
  /* The subject's geometry is published here, on the section, because
     Wordmark.astro places the letters from it (increment 28): the painted
     height is min(width × ratio, max-height), and the head starts
     --subject-head of the way down it. --subject-ratio comes from the image
     metadata; --subject-head was measured off the PNG (first row with alpha
     over 50%: row 47 of 1192) — re-measure it if the cutout changes. */
  .hero {
    --subject-w: min(88vw, 470px);
    --subject-max-h: 86dvh;
    --subject-head: 0.0394;
    /* The letters' box, placed from the subject (Wordmark.astro explains
       the maths) and published here since increment 32, where the sky can
       read it too: its meteor lane starts below the letters. */
    --wm-w: clamp(320px, 72vw, 1100px);
    --wm-h: calc(var(--wm-w) * 735 / 2055);
    --overlap: 0.56;
    --letters-top: max(
      calc(var(--nav-height) + 0.5rem),
      calc(
        100dvh - (1 - var(--subject-head)) * min(var(--subject-w) * var(--subject-ratio), var(--subject-max-h)) -
          (1 - var(--overlap)) * var(--wm-h)
      )
    );
    position: relative;
    display: grid;
    min-height: 100dvh;
    overflow: clip;
    background-color: var(--bg);
  }

  /* --- Layer B: subject -------------------------------------------------- */
  .subject {
    position: relative;
    z-index: 2;
    grid-area: 1 / 1;
    align-self: end;
    justify-self: center;
    width: var(--subject-w);
  }

  /* Bottom-anchored. The PNG's built-in fade lands at the hero's bottom edge,
     so nothing below the vest reads as a cut. */
  .subject :global(img) {
    width: 100%;
    height: auto;
    max-height: var(--subject-max-h);
    object-fit: contain;
    object-position: bottom center;
  }

  /* 640px rather than the project's usual 768px: below it the 72vw cap
     makes the wordmark too small to carry the composition, so it goes
     near-full-bleed with a 26% overlap, and the subject grows taller so the
     shoulders still reach up into the short mobile letters. */
  @media (max-width: 639px) {
    .hero {
      --subject-w: 88vw;
      --subject-max-h: 82dvh;
      --wm-w: 88vw;
      --overlap: 0.26;
    }
  }
</style>
