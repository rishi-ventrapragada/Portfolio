---
// The skills of one hub below 960px (PRD §5.6): a wrapping chain hung from a
// left spine, every skill ticked to the spine or to the one before it, so
// nothing ever shrinks. Increment 19's layout, unchanged in increment 31,
// when it became one hub's part of the skills list (SkillsList.astro) —
// the mobile and no-JS layout, and the graph's accessible content.
//
// Leaves are static text: there is no per-skill detail to reveal
// (inventing one is CLAUDE.md §7), so a list reads faster than a widget
// and every node's visible text is its accessible name.
interface Props {
  items: string[];
  /** Currently learning: the shared `.planned` treatment, dashed lines. */
  learning?: boolean;
  /** Graph node id of the first item (increment 31): each item carries
   * data-node so the keyboard's focus can light its star. */
  start?: number;
}

const { items, learning = false, start } = Astro.props;
---

<ul class="chain" data-planned={learning ? "" : undefined}>
  {
    items.map((item, i) => (
      <li class:list={["node", { planned: learning }]} data-node={start === undefined ? undefined : start + i}>
        {item}
      </li>
    ))
  }
</ul>

<style>
  /* Node defaults live in @layer components so the shared, unlayered
     `.planned` utility (utilities.css) wins border-style and opacity. */
  @layer components {
    .node {
      position: relative;
      margin: 0;
      padding: 0.5rem 0.625rem;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      letter-spacing: 0.04em;
      line-height: 1.2;
      white-space: nowrap;
      color: var(--fg);
      background-color: var(--bg-raised);
      border: 1px solid var(--line);
      border-radius: 4px;
    }
  }

  /* The horizontal gap equals the tick, so a leaf's tick meets the leaf
     before it, or the spine when it starts a row. */
  .chain {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 14px;
    margin: 0 0 0 1.75rem;
    padding: 0.75rem 0 0.25rem 14px;
    list-style: none;
    border-left: 2px solid var(--tone, var(--accent));
  }

  /* Every connector is a 2px bar at full opacity, in the hub's tone
     (SkillsList.astro sets --tone per hub, increment 33). */
  .node::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 100%;
    width: 14px;
    height: 2px;
    margin-top: -1px;
    background-color: var(--tone, var(--accent));
  }

  /* --- Currently learning: dashed spine and connectors ---------------- */
  .chain[data-planned] {
    border-left-style: dashed;
  }

  .chain[data-planned] .node::before {
    height: 0;
    background: none;
    border-top: 2px dashed var(--tone, var(--accent));
  }
</style>
