---
// The leaves of one skill-tree category below 960px (PRD §5.6): a wrapping
// chain hung from a left spine, every leaf ticked to the spine or to the leaf
// before it, so nothing ever shrinks. Increment 19's layout, unchanged.
//
// Desktop is a different layout entirely — the free-scatter mind map in
// SkillGroup.astro (increment 22) — which hides this list from 960px. The
// column grid this file used to carry went with the fan it belonged to.
//
// Leaves are static text: there is no per-skill detail to reveal
// (inventing one is CLAUDE.md §7), so a list reads faster than a widget
// and every node's visible text is its accessible name.
interface Props {
  items: string[];
  /** Currently learning: the shared `.planned` treatment, dashed lines. */
  learning?: boolean;
}

const { items, learning = false } = Astro.props;
---

<ul class="chain" data-planned={learning ? "" : undefined}>
  {items.map((item) => <li class:list={["node", { planned: learning }]}>{item}</li>)}
</ul>

<style>
  /* Node defaults live in @layer components so the shared, unlayered
     `.planned` utility (global.css) wins border-style and opacity. */
  @layer components {
    .node {
      position: relative;
      margin: 0;
      padding: 0.5rem 0.625rem;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      letter-spacing: 0.04em;
      line-height: 1.2;
      white-space: nowrap;
      color: var(--fg);
      background-color: var(--bg-raised);
      border: 1px solid var(--line);
      border-radius: 4px;
    }
  }

  /* The horizontal gap equals the tick, so a leaf's tick meets the leaf
     before it, or the spine when it starts a row. */
  .chain {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 14px;
    margin: 0 0 0 1.75rem;
    padding: 0.75rem 0 0.25rem 14px;
    list-style: none;
    border-left: 2px solid var(--accent);
  }

  /* Every connector is a 2px accent bar at full opacity. */
  .node::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 100%;
    width: 14px;
    height: 2px;
    margin-top: -1px;
    background-color: var(--accent);
  }

  /* --- Currently learning: dashed spine and connectors ---------------- */
  .chain[data-planned] {
    border-left-style: dashed;
  }

  .chain[data-planned] .node::before {
    height: 0;
    background: none;
    border-top: 2px dashed var(--accent);
  }
</style>
