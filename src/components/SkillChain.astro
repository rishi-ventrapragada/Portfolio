---
// The leaves of one skill-tree category (PRD §5.6): a single list whose
// items read down one column then the next. From 960px it is two grid
// columns and each leaf is joined to the one above by a solid accent
// connector — the head of each column has none, the group's fan reaches it.
// Below 960px it is a wrapping chain hung from a left spine, every leaf
// ticked to the spine or to the leaf before it, so nothing ever shrinks.
// The column split is computed here at build time; no client script.
//
// Leaves are static text: there is no per-skill detail to reveal
// (inventing one is CLAUDE.md §7), so a list reads faster than a widget
// and every node's visible text is its accessible name.
interface Props {
  items: string[];
  /** Currently learning: the shared `.planned` treatment, dashed lines. */
  learning?: boolean;
}

const { items, learning = false } = Astro.props;

const rows = Math.ceil(items.length / 2);
const nodes = items.map((item, i) => ({ item, head: i % rows === 0 }));
---

<ul class="chain" style={`--rows: ${rows}`} data-planned={learning ? "" : undefined}>
  {
    nodes.map(({ item, head }) => (
      <li class:list={["node", { planned: learning }]} data-head={head ? "" : undefined}>
        {item}
      </li>
    ))
  }
</ul>

<style>
  /* Node defaults live in @layer components so the shared, unlayered
     `.planned` utility (global.css) wins border-style and opacity. */
  @layer components {
    .node {
      position: relative;
      margin: 0;
      padding: 0.5rem 0.625rem;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      letter-spacing: 0.04em;
      line-height: 1.2;
      white-space: nowrap;
      color: var(--fg);
      background-color: var(--bg-raised);
      border: 1px solid var(--line);
      border-radius: 4px;
    }
  }

  /* Every connector is a 2px accent bar at full opacity. */
  .node::before {
    content: "";
    position: absolute;
    background-color: var(--accent);
  }

  /* --- Below 960px: a spine with a wrapping chain ---------------------- */
  /* The horizontal gap equals the tick, so a leaf's tick meets the leaf
     before it, or the spine when it starts a row. */
  .chain {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 14px;
    margin: 0 0 0 1.75rem;
    padding: 0.75rem 0 0.25rem 14px;
    list-style: none;
    border-left: 2px solid var(--accent);
  }

  .node::before {
    top: 50%;
    right: 100%;
    width: 14px;
    height: 2px;
    margin-top: -1px;
  }

  /* --- From 960px: two columns, vertical connectors ------------------- */
  @media (min-width: 960px) {
    /* Filled top to bottom then across (grid-auto-flow: column); --rows
       from the build so the second column starts at the right item. */
    .chain {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(var(--rows), auto);
      grid-auto-flow: column;
      gap: 16px 1rem;
      margin: 0;
      padding: 0;
      border-left: 0;
    }

    .node {
      text-align: center;
    }

    .node::before {
      top: auto;
      right: auto;
      bottom: 100%;
      left: 50%;
      width: 2px;
      height: 16px;
      margin: 0 0 0 -1px;
    }

    .node[data-head]::before {
      content: none;
    }
  }

  /* --- Currently learning: dashed spine and connectors ---------------- */
  .chain[data-planned] {
    border-left-style: dashed;
  }

  .chain[data-planned] .node::before {
    height: 0;
    background: none;
    border-top: 2px dashed var(--accent);
  }

  @media (min-width: 960px) {
    .chain[data-planned] .node::before {
      width: 0;
      height: 16px;
      border-top: 0;
      border-left: 2px dashed var(--accent);
    }
  }
</style>
