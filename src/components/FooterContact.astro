---
// PRD §5.8 — the contact card: the last stage of the footer sequence
// (Footer.astro owns the track and the pin, FooterStage.astro the stage box).
// "Get in touch" and the links sit dead centre, so when the stage settles
// the links are in the middle of the viewport; the © line is pinned to the
// stage's bottom edge, out of the centring. Split out of Footer.astro for
// the CLAUDE.md §5 line cap.
//
// Contact values go through the shared isUrl guard (src/lib/is-url.ts):
// only an http(s) URL or a mailto: address becomes an <a>, anything else
// (a "[TODO]" placeholder, CLAUDE.md §7) renders as visible mono text.
// The résumé link stays outside the guard as built: a root-relative path
// to public/resume.pdf, which is still pending from the owner.
import { isUrl } from "../lib/is-url";

const year = new Date().getFullYear();

const contacts = [
  { label: "GitHub", value: "https://github.com/rishi-ventrapragada" },
  { label: "LinkedIn", value: "https://www.linkedin.com/in/rishi-ventrapragada" },
  { label: "Gmail", value: "mailto:rishiventrapragada23@gmail.com" },
];
---

<div class="contact" data-contact>
  <div class="body">
    <p class="label get-in-touch">Get in touch</p>
    <ul class="links">
      {
        contacts.map(({ label, value }) =>
          isUrl(value) ? (
            <li>
              <a class="meta link" href={value} rel="noopener">
                {label}
              </a>
            </li>
          ) : (
            <li class="meta pending">
              {label} &mdash; {value}
            </li>
          ),
        )
      }
      <li>
        <a class="meta link" href="/resume.pdf">Résumé [TODO]</a>
      </li>
    </ul>
  </div>

  <p class="meta copyright">&copy; {year} Rishi</p>
</div>

<style>
  /* FooterStage.astro is the pin-height box now (increment 21). The card
     fills that whole box — stretched in both axes, overriding the stage's
     centring — so the © line's absolute positioning anchors to the stage's
     real bottom edge; the body stays centred within it. */
  .contact {
    position: relative;
    display: grid;
    place-content: center;
    justify-self: stretch;
    align-self: stretch;
    width: 100%;
    height: 100%;
    text-align: center;
  }

  .body {
    display: grid;
    gap: 1.5rem;
  }

  .get-in-touch {
    margin: 0;
    color: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link {
    color: var(--fg);
  }

  .link:hover {
    color: var(--accent);
  }

  .copyright {
    position: absolute;
    inset-inline: 0;
    bottom: 2rem;
    margin: 0;
  }
</style>
