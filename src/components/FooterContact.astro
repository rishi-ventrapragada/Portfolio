---
// PRD §5.8 — the contact screen: the last stage of the footer sequence
// (Footer.astro owns the track and the pin, FooterStage.astro the stage box).
// Since increment 23 the links are rectangular button-cards with a
// hand-authored glyph each (ContactCard.astro), under a display-size "Get in
// touch", all dead centre; the © line is pinned to the stage's bottom edge,
// out of the centring, and is unchanged.
//
// Contact values go through the shared isUrl guard (src/lib/is-url.ts):
// only an http(s) URL or a mailto: address becomes an <a>, anything else
// (a "[TODO]" placeholder, CLAUDE.md §7) renders as visible mono text.
// The résumé is a card of its own under the three (increment 25), outside
// the guard: it links to /resume.pdf only if public/resume.pdf exists at
// build time, and until then renders as a dashed "[TODO]" card that is not
// a link, so the page never ships a 404.
import { isUrl } from "../lib/is-url";
import ContactCard from "./ContactCard.astro";

// A glob match is only a listing: nothing is imported unless it is called.
const hasResume = Object.keys(import.meta.glob("/public/resume.pdf")).length > 0;

const year = new Date().getFullYear();

const contacts = [
  { label: "GitHub", value: "https://github.com/rishi-ventrapragada", icon: "github" },
  { label: "LinkedIn", value: "https://www.linkedin.com/in/rishi-ventrapragada", icon: "linkedin" },
  { label: "Gmail", value: "mailto:rishiventrapragada23@gmail.com", icon: "mail" },
] as const;
---

<div class="contact" data-contact>
  <div class="body">
    <h2 class="get-in-touch">Get in touch</h2>
    <ul class="cards">
      {
        contacts.map(({ label, value, icon }) =>
          isUrl(value) ? (
            <li>
              <ContactCard label={label} href={value} icon={icon} />
            </li>
          ) : (
            <li class="meta pending">
              {label} &mdash; {value}
            </li>
          ),
        )
      }
    </ul>
    <div class="resume">
      <ContactCard label="Résumé" icon="resume" href={hasResume ? "/resume.pdf" : undefined} />
    </div>
  </div>

  <p class="meta copyright">&copy; {year} Rishi</p>
</div>

<style>
  /* FooterStage.astro is the pin-height box now (increment 21). The card
     fills that whole box — stretched in both axes, overriding the stage's
     centring — so the © line's absolute positioning anchors to the stage's
     real bottom edge; the body stays centred within it. */
  .contact {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    justify-self: stretch;
    align-self: stretch;
    width: 100%;
    height: 100%;
    text-align: center;
  }

  .body {
    display: grid;
    justify-items: center;
    gap: 2rem;
    width: min(100%, 64rem);
  }

  /* h2: the footer is its own landmark with no heading of its own; the
     credits above are decorative text, so this is the section's title. */
  .get-in-touch {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--heading);
    text-shadow: 0 0 0.5rem var(--bg);
  }

  /* Three across from 960px, one column below: each card keeps a width
     where its address fits on one or two lines. */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 960px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Phone: tighter spacing so the whole screen clears the © line pinned to
     the stage's bottom edge even on a 320×568 viewport. */
  /* Since increment 25 the résumé card adds a fourth row, so the body is
     also centred in the space above the © line (2rem off the bottom plus
     its own line) rather than the whole stage — at 320×568 it otherwise
     lands on it. The résumé keeps the cards' own gap. */
  @media (max-width: 479.98px) {
    .contact {
      padding-bottom: 3.5rem;
    }

    .body {
      gap: 1.25rem;
    }

    .cards {
      gap: 0.625rem;
    }

    .resume {
      margin-top: -0.625rem;
    }
  }

  /* One card wide, centred under the three: the same scale as each of
     them. Below 960px the cards are one column and so is this. */
  .resume {
    width: 100%;
  }

  @media (min-width: 960px) {
    .resume {
      width: calc((100% - 2rem) / 3);
      margin-top: -1rem;
    }
  }

  /* Straight on the contours like the credits, so it wears the same halo
     (Footer.astro), plus a finer inner ring at 0.8px and 2.25px: on 11px
     glyphs the halo's two rings alone left single gap pixels (3.84:1 worst
     at 320×568). With both: 5.66:1 worst near any glyph, five viewports;
     3.16:1 with no halo at all (increment 28). */
  .copyright {
    position: absolute;
    inset-inline: 0;
    bottom: 2rem;
    margin: 0;
    text-shadow:
      var(--halo),
      2.25px 0 0 var(--bg), 1.6px 1.6px 0 var(--bg), 0 2.25px 0 var(--bg), -1.6px 1.6px 0 var(--bg),
      -2.25px 0 0 var(--bg), -1.6px -1.6px 0 var(--bg), 0 -2.25px 0 var(--bg), 1.6px -1.6px 0 var(--bg),
      0.8px 0 0 var(--bg), -0.8px 0 0 var(--bg), 0 0.8px 0 var(--bg), 0 -0.8px 0 var(--bg);
  }
</style>
