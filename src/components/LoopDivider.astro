---
// A drifting pattern seam between two sections (PRD §5.12, increment 25):
// an SVG strip slotted in by its own component — EdgeCode.astro and
// LeaderStrip.astro since increment 29, ClapperStrip.astro since increment
// 30 (the CSS-gradient clapper this used to draw is gone). Each loops right
// to left forever.
//
// The loop is Starfield.astro's: a track twice the width of one copy of the
// pattern, translated -50%, so the second copy lands exactly where the first
// began. Starfield gets an exact copy for free because every star is drawn a
// second time exactly 100cqw to the right. A pattern tile is in px, so here "one copy" is the section
// width rounded UP to a whole number of tiles (--half) — the track is 2 ×
// --half wide and overflows the seam, clipped. The -50% shift is then a
// whole number of tiles and the wrap cannot show.
//
// The sprocket Divider.astro still owns Hero/About; this owns the rest.
interface Props {
  variant: "strip";
  /** The slotted SVG's tile width and height, px. */
  tile: number;
  height: number;
}

const { variant, tile, height } = Astro.props;
const style = `--tile-w: ${tile}px; --h: ${height}px`;
---

{/* A "strip" draws its tile as SVG (EdgeCode.astro, LeaderStrip.astro,
    ClapperStrip.astro), slotted into the track; this only loops it. */}
<div class="loop" data-variant={variant} data-offscreen-pause aria-hidden="true" style={style}>
  <div class="track"><slot /></div>
</div>

<style>
  /* contain: strict — fixed height, width from the parent, so nothing inside
     can affect layout outside and the browser can skip it off-screen. The
     inline-size container is what gives the track its 100cqw. */
  .loop {
    position: relative;
    height: var(--h);
    overflow: clip;
    container-type: inline-size;
    contain: strict;
  }

  /* Without round() the copy is one plain section width, and the wrap may
     jump by part of a tile once per loop. */
  .track {
    --half: 100cqw;
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(var(--half) * 2);
    will-change: transform;
    animation: loop var(--loop) linear infinite;
  }

  @supports (width: round(up, 1px, 1px)) {
    .track {
      --half: round(up, 100cqw, var(--tile-w));
    }
  }

  @keyframes loop {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* --- SVG strips (increment 29) -------------------------------------------
     The slotted SVG fills the track and repeats its tile with a <pattern>;
     its own component owns the drawing and the colours. */
  [data-variant="strip"] {
    --loop: 48s;
  }

  /* Decorative, autonomous drift: frozen at its first frame, the Starfield
     rule, so the seam is still complete and still. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
