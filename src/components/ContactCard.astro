---
// One contact button-card on the footer's contact screen (PRD §5.8,
// increment 23): a rectangular link with a brand mark or envelope (see
// ContactIcon.astro — the glyph never takes the accent), the label,
// and the address itself underneath, so the card says where it goes before
// it is clicked. Only ever rendered for a real URL (FooterContact.astro keeps
// the isUrl guard) — except the résumé card (increment 25), which has no
// href while its file is missing and then renders as a dashed placeholder
// that is not a link, with `pending` as its visible address. Link cards are
// magnetic on a fine pointer (scripts/magnetic.ts); the placeholder is not.
import ContactIcon from "./ContactIcon.astro";

interface Props {
  label: string;
  href?: string;
  icon: "github" | "linkedin" | "mail" | "resume";
  /** What the card says in place of an address while there is no href. */
  pending?: string;
  /** Larger and heavier (the résumé, increment 30). */
  prominent?: boolean;
}

const { label, href, icon, pending = "[TODO]", prominent = false } = Astro.props;
// The address as a reader would say it: no scheme, no "www.", no trailing
// slash, the bare address for mail, the file name for a root-relative path.
const address = href
  ? href.replace(/^mailto:/, "").replace(/^https?:\/\/(www\.)?/, "").replace(/^\//, "").replace(/\/$/, "")
  : pending;
---

{
  href ? (
    <a class:list={["card", { prominent }]} href={href} rel="noopener" data-magnetic>
      <ContactIcon name={icon} />
      <span class="text">
        <span class="label-text">{label}</span>
        <span class="meta address">{address}</span>
      </span>
    </a>
  ) : (
    <div class:list={["card", { prominent }]} data-pending>
      <ContactIcon name={icon} />
      <span class="text">
        <span class="label-text">{label}</span>
        <span class="meta address">{address}</span>
      </span>
    </div>
  )
}

<script>
  import { initMagnetic } from "../scripts/magnetic";

  initMagnetic();
</script>

<style>
  /* --edge (increment 30): a border you can actually see. --line on
     --bg-raised is 1.29:1, which read as no border at all. --fg-muted at
     70% into the card colour, the muted-rule convention the slate uses at
     full strength: 3.88:1 on the card, 4.18 on --bg, ~3.1 on the beam's
     brightest ground — every side of the edge clears the 3:1 non-text
     minimum. Hover and focus still swap it for the accent (5.24:1). */
  .card {
    --edge: color-mix(in srgb, var(--fg-muted) 70%, var(--bg-raised));
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 5rem;
    padding: 1rem 1.25rem;
    color: var(--fg);
    background-color: var(--bg-raised);
    border: 1px solid var(--edge);
    border-radius: 4px;
    text-align: left;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* While following the cursor: a short ease, so the lean tracks without
     lag. On leave data-pulling goes and the long overshoot above springs it
     back to rest. Transform only — the compositor does all of it. */
  .card[data-pulling] {
    transition-duration: 160ms, 160ms, 120ms;
    transition-timing-function: ease, ease, ease-out;
  }

  .address {
    transition: color 160ms ease;
  }

  .card:hover,
  .card:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Not a link yet: a dashed edge, the .planned cue (PRD §5.3), and no
     hover. The opacity half of .planned is left out on purpose — it would
     take the [TODO] text below AA. */
  .card[data-pending] {
    border-style: dashed;
  }

  .card[data-pending]:hover {
    border-color: var(--edge);
  }

  /* The address carries the hover colour the glyph no longer can: crimson
     4.95:1 on --bg-raised. */
  a.card:hover .address,
  .card:focus-visible .address {
    color: var(--accent);
  }

  .text {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .label-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--heading);
  }

  /* Long addresses (the LinkedIn path) wrap at any character rather than
     widen the card past a phone's width. 0.02em, not 0.04: at 0.04 the
     LinkedIn path overran its 1280px card by about a pixel and wrapped,
     making that card 97px to the others' 80 (increment 28). It now fits on
     one line wherever the three cards reach full width (1120px up). */
  .address {
    overflow-wrap: anywhere;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* The résumé (increment 30): taller, a larger label and glyph, so it
     carries the weight of the row above rather than trailing under it. */
  .prominent {
    min-height: 6rem;
    padding: 1.25rem 1.75rem;
    gap: 1.25rem;
  }

  .prominent .label-text {
    font-size: 1.5rem;
  }

  .prominent :global(.icon) {
    width: 2.25rem;
    height: 2.25rem;
  }

  @media (max-width: 479.98px) {
    .card {
      min-height: 3.75rem;
      padding: 0.625rem 1rem;
    }

    .label-text {
      font-size: 1.0625rem;
    }

    .prominent {
      min-height: 4.25rem;
    }

    .prominent .label-text {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .address {
      transition: none;
    }
  }
</style>
