---
// Meta panel for a case study sidebar (PRD §5.5): role, stack and links from
// frontmatter. Status and year are in the page eyebrow, not repeated here.
interface Props {
  role: string;
  stack: string[];
  links: { live?: string; repo?: string };
}

const { role, stack, links } = Astro.props;

// A link value may hold a visibly marked "[TODO]" placeholder, which must
// never become an href. Only real URLs are rendered as links.
const isUrl = (value?: string) => !!value && /^https?:\/\//.test(value);
const pending = [
  links.live && !isUrl(links.live) ? links.live : null,
  links.repo && !isUrl(links.repo) ? links.repo : null,
].filter(Boolean);
---

<dl class="facts">
  <div class="fact">
    <dt class="meta">Role</dt>
    <dd>{role}</dd>
  </div>

  <div class="fact">
    <dt class="meta">Stack</dt>
    <dd>
      <ul class="stack">
        {stack.map((item) => <li class="meta">{item}</li>)}
      </ul>
    </dd>
  </div>

  {
    (isUrl(links.live) || isUrl(links.repo)) && (
      <div class="fact">
        <dt class="meta">Links</dt>
        <dd class="links">
          {isUrl(links.live) && <a href={links.live}>Live</a>}
          {isUrl(links.repo) && <a href={links.repo}>Repo</a>}
        </dd>
      </div>
    )
  }

  {
    pending.length > 0 && (
      <div class="fact">
        <dt class="meta">Links</dt>
        {/* Placeholder stays visible per CLAUDE.md §7, but never as a link. */}
        <dd class="meta pending">{pending.join(" ")}</dd>
      </div>
    )
  }
</dl>

<style>
  .facts {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding-block: 2rem;
    border-block: 1px solid var(--line);
  }

  /* Between the mobile stack and the desktop sidebar the facts read better
     as a row than as a tall column. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .facts {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .facts {
      padding-block: 0 2rem;
      border-block-start: 0;
    }
  }

  .fact dt {
    margin-bottom: 0.5rem;
  }

  .fact dd {
    margin: 0;
    color: var(--fg);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .pending {
    color: var(--fg-muted);
  }
</style>
