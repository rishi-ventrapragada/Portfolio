---
// One comic panel for About.astro (PRD §5.6). A figure: the art block, then
// a caption box laid over its top-left corner the way a comic caption sits
// inside the panel. Both are placeholders until the owner supplies art and
// dialogue (CLAUDE.md §7): the art is a solid fill from the small palette
// with a mono tag, the caption is a visible [TODO]. The placement of the
// establishing panel in the grid belongs to About.astro; this file only
// carries the class.
interface Props {
  n: number;
  tone: "amber" | "sky" | "mint" | "periwinkle" | "coral";
  establishing?: boolean;
}

const { n, tone, establishing = false } = Astro.props;
---

<figure class:list={["panel", { establishing }]}>
  <div
    class="art"
    style={`--tone: var(--word-${tone})`}
    role="img"
    aria-label={`Panel ${n} placeholder art`}
  >
    <span class="meta tag">[PANEL {n} &mdash; placeholder art]</span>
  </div>
  <figcaption class="label caption">[TODO: panel {n} dialogue]</figcaption>
</figure>

<style>
  .panel {
    position: relative;
    margin: 0;
    overflow: hidden;
    /* Phone: the grid has no fixed height, so each panel sets its own. */
    aspect-ratio: 4 / 3;
    background-color: var(--bg-raised);
    border: 1px solid var(--line);
  }

  /* Reveal (scripts/about-reveal.ts). The hidden start state applies only
     once the script has armed the grid with [data-reveal], so without JS —
     or under reduced motion, where the script never arms — every panel is
     simply visible. Transform and opacity only; --reveal-delay staggers
     panels that enter together so they land one after another. */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-reveal]) > .panel {
      transition:
        opacity 600ms ease var(--reveal-delay, 0ms),
        transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--reveal-delay, 0ms);
    }

    :global([data-reveal]) > .panel:not([data-revealed]) {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  /* Desktop: the grid's rows decide the height (About.astro). */
  @media (min-width: 768px) {
    .panel {
      aspect-ratio: auto;
    }
  }

  .art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    text-align: center;
  }

  /* One rule for all five fills; the panel passes its palette word as
     --tone. The mix partner is --panel-ink, not --bg-raised directly,
     because the operand's job here is "darken the word to a swatch". On a
     light surface --bg-raised is white, so the same expression would wash
     all five fills out to pastel; the light scope keeps a dark partner and a
     lower word share so the swatches stay swatches and the grade cycle still
     has something to act on. */
  .art {
    --panel-ink: var(--bg-raised);
    --panel-mix: 52%;
    --tag-ink: var(--fg);
    background-color: color-mix(in srgb, var(--tone) var(--panel-mix), var(--panel-ink));
  }

  /* Light scope: a dark mix partner and a higher word share, so the swatches
     stay swatches. The tag's ink flips with them. Tokens, not literals,
     since increment 28: the scope's own --fg (#1a1b1e) is the partner (it
     was a #2a2b30 literal, a hair lighter, which moves each fill by 4–5 of
     255) and its --heading (#111214) the ink, the value the literal had.
     Measured across all five fills: near-black 4.97:1 at worst (5.28 with
     the old partner), where white is under 3. */
  :global([data-theme="light"]) .art {
    --panel-ink: var(--fg);
    --panel-mix: 72%;
    --tag-ink: var(--heading);
  }

  /* Its own token, not --bg or --on-accent: the fills are neither the page
     nor the accent, and the ink that wins on them is the opposite of
     --on-accent's in both themes. 52% keeps the darkest dark-theme fill at
     4.6:1 against white; at the old 60% it was 3.97, under AA. */
  .tag {
    color: var(--tag-ink);
  }

  .caption {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0.5rem 0.75rem;
    background-color: var(--bg);
    border: 1px solid var(--line);
    color: var(--fg);
    line-height: 1.5;
  }
</style>
