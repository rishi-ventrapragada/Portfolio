---
// Project tile (PRD §5.3). Data comes from the projects collection.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, summary, stack, status, year, cover, video } = entry.data;
const href = `/projects/${entry.id}/`;
---

<article class="tile">
  <div class="cover">
    {
      video ? (
        // Muted looping demo per PRD §5.3. No project has video yet, so this
        // branch is unexercised until increment 4 supplies the assets. There is
        // deliberately no `autoplay`: §5.3 wants it paused under reduced
        // motion, which CSS cannot do, so the script below opts in instead.
        <video
          poster={video.poster}
          muted
          loop
          playsinline
          data-demo
          aria-label={`${title} demo`}
        >
          <source src={video.webm} type="video/webm" />
          <source src={video.mp4} type="video/mp4" />
        </video>
      ) : (
        <Image
          src={cover}
          alt={`${title} project cover`}
          widths={[636, 1272]}
          sizes="(min-width: 768px) 700px, 92vw"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>

  <div class="body">
    {/* No `type` field in the schema, so the eyebrow is built from real data
        rather than invented copy (CLAUDE.md §7). */}
    <p class="label eyebrow">{status} &middot; {year}</p>
    {/* h3: the section owns the h2 and the hero owns the page's only h1. */}
    <h3 class="title"><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
    <ul class="stack">
      {stack.map((item) => <li class="meta">{item}</li>)}
    </ul>
  </div>

  {/* Inside the <article> on purpose: as a sibling it would become a second
      child of the grid and break the :only-child split layout. Starts playback
      only when motion is allowed, leaving the poster otherwise (PRD §5.3). */}
  <script>
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      for (const el of document.querySelectorAll<HTMLVideoElement>("[data-demo]")) {
        el.play().catch(() => {
          /* Autoplay refused (battery saver, data saver) — poster stays. */
        });
      }
    }
  </script>
</article>

<style>
  .tile {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: 1.5rem;
    background-color: var(--bg-raised);
    border: 1px solid var(--line);
    transition: border-color 160ms ease;
  }

  .tile:hover,
  .tile:has(a:focus-visible) {
    border-color: var(--accent);
  }

  /* The focus ring belongs around the whole card, not the title sliver. */
  .tile:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .cover {
    overflow: hidden;
  }

  /* The cover is a screenshot, so it sets its own ratio rather than being
     cropped to 16/9: at 1272x700 (1.82:1) a forced 16/9 box would shave
     ~14px off each side, and clipped UI chrome reads as a mistake in a
     screenshot in a way it would not in a photo. Video keeps 16/9, the
     ratio PRD §7 specifies for demo posters. */
  .cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .cover video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
  }

  .title {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  /* Stretched link: one real link, the whole card as its hit area, with the
     title as its accessible name. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .summary {
    margin: 0;
    max-width: 60ch;
    color: var(--fg);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

