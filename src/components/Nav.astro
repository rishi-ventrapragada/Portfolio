---
// PRD 5.1 — fixed bar. Menu behaviour is [next]; the button exists now but is inert.
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="label brand" href="/">Rishi &copy;</a>

    <div class="center meta" aria-hidden="true">
      <span>Portfolio 01</span>
      <span>MMXXVI</span>
    </div>

    <div class="right">
      <div class="meta stack">
        <span>CSE &middot; Data Science</span>
        <span>Hyderabad, IN</span>
      </div>
      <button
        type="button"
        class="burger"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="Open menu"
        disabled
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Adds .is-scrolled once the hero is behind the bar (PRD 4.4).
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:100dvh;height:1px;width:1px;";
    document.body.prepend(sentinel);

    new IntersectionObserver(
      ([entry]) => nav.classList.toggle("is-scrolled", !entry.isIntersecting),
      { rootMargin: "0px" },
    ).observe(sentinel);
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .nav.is-scrolled {
    background-color: var(--bg-raised);
    border-bottom-color: var(--line);
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    gap: 1rem;
  }

  .brand {
    color: var(--fg);
  }

  .center {
    display: none;
    justify-self: center;
    text-align: center;
    line-height: 1.35;
  }

  .center span,
  .stack span {
    display: block;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .stack {
    display: none;
    text-align: right;
    line-height: 1.35;
  }

  .burger {
    display: grid;
    gap: 5px;
    width: 28px;
    padding: 6px 0;
    background: none;
    border: 0;
    cursor: not-allowed;
  }

  .burger span {
    display: block;
    height: 1px;
    background-color: var(--fg);
    transition: background-color 160ms ease;
  }

  .burger:hover:not(:disabled) span {
    background-color: var(--accent);
  }

  @media (min-width: 768px) {
    .nav-inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .center,
    .stack {
      display: block;
    }

    .right {
      justify-self: end;
    }
  }
</style>
