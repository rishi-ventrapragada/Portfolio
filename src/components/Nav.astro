---
// PRD §5.1 — a fixed bar, transparent over the hero, solid once past it.
// Single-page site: every entry is an anchor on this page, so there is no
// current-page state, no hamburger and no responsive collapse. Three short
// labels fit at every width (measured in SESSION.md, increment 6).
const links = [
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="nav" data-nav>
  <nav class="nav-inner" aria-label="Primary">
    {/* `#top` with no matching element scrolls to the document top per the
        HTML spec, so the hero needs no id and there is no reload. */}
    <a class="label mark" href="#top">Rishi</a>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a class="label link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Adds .is-scrolled once the hero is behind the bar (PRD §4.4). Module
  // scope is fine here: there is no client router swapping the DOM out from
  // under it, so the observer is bound once and stays bound.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:100dvh;height:1px;width:1px;";
    document.body.prepend(sentinel);

    new IntersectionObserver(
      ([entry]) => nav.classList.toggle("is-scrolled", !entry.isIntersecting),
      { rootMargin: "0px" },
    ).observe(sentinel);
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .nav.is-scrolled {
    background-color: var(--bg-raised);
    border-bottom-color: var(--line);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    /* Gutter keeps the mark and links on the same line as page content rather
       than floating at the very edge. */
    padding-inline: var(--gutter);
  }

  .mark {
    display: block;
    padding-block: 0.5rem;
    color: var(--heading);
  }

  .mark:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .links {
      gap: 2rem;
    }
  }

  .link {
    display: block;
    padding-block: 0.5rem;
    color: var(--fg);
  }

  .link:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>
