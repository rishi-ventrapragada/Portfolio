---
// PRD 5.1 — a single fixed hamburger, top right. Menu behaviour is [next];
// the button exists now and stays inert until then.
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <button
      type="button"
      class="burger"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
      disabled
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  // Adds .is-scrolled once the hero is behind the bar (PRD 4.4).
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:100dvh;height:1px;width:1px;";
    document.body.prepend(sentinel);

    new IntersectionObserver(
      ([entry]) => nav.classList.toggle("is-scrolled", !entry.isIntersecting),
      { rootMargin: "0px" },
    ).observe(sentinel);
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .nav.is-scrolled {
    background-color: var(--bg-raised);
    border-bottom-color: var(--line);
  }

  .nav-inner {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    /* Gutter keeps the button on the same line as page content rather than
       floating at the very edge. */
    padding-inline: var(--gutter);
  }

  /* 64px square hit area; the bars themselves stay 28px wide, right-aligned
     inside it so they sit on the gutter line. */
  .burger {
    display: grid;
    align-content: center;
    justify-items: end;
    gap: 5px;
    width: var(--nav-height);
    height: var(--nav-height);
    padding: 0;
    background: none;
    border: 0;
    cursor: not-allowed;
  }

  .burger span {
    display: block;
    width: 28px;
    height: 1px;
    background-color: var(--fg);
    transition: background-color 160ms ease;
  }

  .burger:hover:not(:disabled) span {
    background-color: var(--accent);
  }
</style>
