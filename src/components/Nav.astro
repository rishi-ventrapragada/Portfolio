---
// PRD §5.1 — a fixed bar, transparent over the hero, solid once past it.
// Four links shown directly: with this few there is nothing worth hiding
// behind a toggle, so there is no hamburger and no open/close state.
// Only routes and anchors that exist today are listed. Community is absent
// because that page does not exist yet; add it here when it ships.
const { pathname } = Astro.url;

// Anchor-only entries are positions on a page, not destinations, so they are
// never "current". `current` is resolved at build time — no client router.
const links = [
  { label: "Home", href: "/", current: pathname === "/" },
  { label: "Work", href: "/#projects-heading", current: false },
  {
    label: "KalaCart",
    href: "/projects/kalacart/",
    current: pathname.startsWith("/projects/kalacart"),
  },
  { label: "About", href: "/about/", current: pathname.startsWith("/about") },
  { label: "Contact", href: "/#contact", current: false },
];
---

<header class="nav" data-nav>
  <nav class="nav-inner" aria-label="Primary">
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a
              class="label link"
              href={link.href}
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Adds .is-scrolled once the hero is behind the bar (PRD §4.4).
  //
  // Runs on astro:page-load, not at module scope: ClientRouter swaps the DOM
  // on navigation but does NOT re-run an identical script, so a module-scope
  // observer would stay bound to the discarded nav and silently stop working
  // from the second page onward.
  let observer: IntersectionObserver | undefined;
  let sentinel: HTMLElement | undefined;

  const setup = () => {
    observer?.disconnect();
    sentinel?.remove();

    const nav = document.querySelector<HTMLElement>("[data-nav]");
    if (!nav) return;

    sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:100dvh;height:1px;width:1px;";
    document.body.prepend(sentinel);

    observer = new IntersectionObserver(
      ([entry]) => nav.classList.toggle("is-scrolled", !entry.isIntersecting),
      { rootMargin: "0px" },
    );
    observer.observe(sentinel);
  };

  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .nav.is-scrolled {
    background-color: var(--bg-raised);
    border-bottom-color: var(--line);
  }

  .nav-inner {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    /* Gutter keeps the links on the same line as page content rather than
       floating at the very edge. */
    padding-inline: var(--gutter);
  }

  .links {
    display: flex;
    /* Measured at 375px: 312px available inside the gutters. Five labels need
       322px at a 1.25rem gap (overflow) but 306px at 1rem, leaving 6px. A
       sixth link will not fit — it needs a different approach, not a smaller
       gap. */
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .links {
      gap: 2rem;
    }
  }

  .link {
    display: block;
    padding-block: 0.5rem;
    color: var(--fg);
    border-bottom: 1px solid transparent;
  }

  .link:hover {
    color: var(--accent);
  }

  /* Current page, not current position: anchor links never carry this. */
  .link[aria-current="page"] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>
