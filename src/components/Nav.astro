---
// PRD §5.1 — a fixed bar, transparent over the hero, solid once past it.
// Single-page site: every entry is an anchor on this page, so there is no
// current-page state, no hamburger and no responsive collapse. Three short
// labels fit at every width (measured in SESSION.md, increment 6).
const links = [
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="nav" data-nav>
  <nav class="nav-inner" aria-label="Primary">
    {/* `#top` with no matching element scrolls to the document top per the
        HTML spec, so the hero needs no id and there is no reload. */}
    <a class="label mark" href="#top">Rishi</a>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a class="label link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {/* Scroll progress (PRD §5.1). The track is the bar's bottom hairline at
      every scroll position; the fill grows left to right with document
      scroll. aria-hidden: it duplicates what the scrollbar already says. */}
  <div class="progress" aria-hidden="true">
    <span class="fill" data-progress-fill></span>
  </div>
</header>

<script>
  // Adds .is-scrolled once the hero is behind the bar (PRD §4.4). Module
  // scope is fine here: there is no client router swapping the DOM out from
  // under it, so the observer is bound once and stays bound.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  if (nav) {
    const sentinel = document.createElement("div");
    sentinel.setAttribute("aria-hidden", "true");
    sentinel.style.cssText = "position:absolute;top:100dvh;height:1px;width:1px;";
    document.body.prepend(sentinel);

    new IntersectionObserver(
      ([entry]) => nav.classList.toggle("is-scrolled", !entry.isIntersecting),
      { rootMargin: "0px" },
    ).observe(sentinel);
  }

  // Progress fill, script branch: only where scroll-driven CSS is unavailable
  // (Firefox as of 152). Same shape as the hero fallback — rAF-throttled,
  // reads only, one style write per frame. Everywhere else the @supports
  // block in <style> drives the fill with no script at all.
  if (!CSS.supports("animation-timeline: scroll()")) {
    const fill = document.querySelector<HTMLElement>("[data-progress-fill]");
    if (fill) {
      let ticking = false;

      const update = () => {
        ticking = false;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const progress = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
        fill.style.setProperty("--scroll-progress", progress.toFixed(4));
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      update();
      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll, { passive: true });
    }
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height);
    background-color: transparent;
    transition: background-color 200ms ease;
  }

  .nav.is-scrolled {
    background-color: var(--bg-raised);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    /* Gutter keeps the mark and links on the same line as page content rather
       than floating at the very edge. */
    padding-inline: var(--gutter);
  }

  .mark {
    display: block;
    padding-block: 0.5rem;
    color: var(--heading);
  }

  .mark:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .links {
      gap: 2rem;
    }
  }

  .link {
    display: block;
    padding-block: 0.5rem;
    color: var(--fg);
  }

  .link:hover {
    color: var(--accent);
  }

  /* --- Scroll progress (PRD §5.1) ---------------------------------------
     The track doubles as the bar's bottom hairline, so .nav has no border of
     its own. No transition on the fill: a progress indicator tracks scroll
     exactly, it never eases toward it. Deliberately on under reduced motion
     too — it follows the visitor's own scroll 1:1 and never moves by itself. */
  .progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background-color: var(--line);
  }

  .fill {
    display: block;
    height: 100%;
    background-color: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--scroll-progress, 0));
  }

  @keyframes progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @supports (animation-timeline: scroll()) {
    /* Longhands in their own rules, never the `animation` shorthand: folded
       together the minifier emits `animation: ... scroll(root)` and browsers
       drop the whole declaration (CLAUDE.md §4). The :where(.nav) prefix
       keeps this rule from merging with the one below. */
    :where(.nav) .fill {
      animation-name: progress-grow;
      animation-duration: 1ms; /* Overridden by the timeline. */
      animation-timing-function: linear;
      animation-fill-mode: both;
    }

    .fill {
      animation-timeline: scroll(root block);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>
