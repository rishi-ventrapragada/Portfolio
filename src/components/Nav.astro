---
// PRD §5.1 — a fixed bar, transparent over the hero, solid once past it.
// Single-page site: every entry is an anchor on this page, so there is no
// current-page state, no hamburger and no responsive collapse. Four labels
// fit only because the bar steps its type down one size below 480px
// (measured in SESSION.md, increment 13 — the margin is tight; a fifth link
// needs a real overflow pattern, not another shrink).
const links = [
  { label: "Skills", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="nav" data-nav>
  <nav class="nav-inner" aria-label="Primary">
    {/* `#top` with no matching element scrolls to the document top per the
        HTML spec, so the hero needs no id and there is no reload. */}
    <a class="label mark" href="#top">Rishi</a>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a class="label link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {/* Scroll progress (PRD §5.1). The fill grows left to right, but only
      past the hero: inside it the bar would read as a broken near-empty
      line, so it is hidden until [data-past-hero] (nav.ts) and its range
      starts at the hero's bottom edge. aria-hidden: it duplicates what the
      scrollbar already says. */}
  <div class="progress" aria-hidden="true">
    <span class="fill" data-progress-fill></span>
  </div>
</header>

<script>
  // Scroll state and the progress-fill fallback live in scripts/nav.ts
  // (CLAUDE.md §5 cap).
  import { initNav } from "../scripts/nav";

  initNav();
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height);
    background-color: transparent;
    transition: background-color 200ms ease;
  }

  .nav.is-scrolled {
    background-color: var(--bg-raised);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    /* Gutter keeps the mark and links on the same line as page content rather
       than floating at the very edge. */
    padding-inline: var(--gutter);
  }

  .mark {
    display: block;
    padding-block: 0.5rem;
    color: var(--heading);
  }

  .mark:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .links {
      gap: 2rem;
    }
  }

  .link {
    display: block;
    padding-block: 0.5rem;
    color: var(--fg);
  }

  .link:hover {
    color: var(--accent);
  }

  /* Phone step-down (PRD §5.1). At 375px the mark plus four 12px / 0.12em
     labels need 383px of 327px; at --size-meta (the footer links' size) with
     the pills' 0.06em tracking and a 0.75rem gap they fit 375 and 360 with
     22px and 7px to spare. Measured, not assumed — see SESSION.md. */
  @media (max-width: 479.98px) {
    .mark,
    .link {
      font-size: var(--size-meta);
      letter-spacing: 0.06em;
    }

    .links {
      gap: 0.75rem;
    }
  }

  /* --- Scroll progress (PRD §5.1) ---------------------------------------
     The track doubles as the bar's bottom hairline, so .nav has no border of
     its own. No transition on the fill: a progress indicator tracks scroll
     exactly, it never eases toward it. Deliberately on under reduced motion
     too — it follows the visitor's own scroll 1:1 and never moves by itself.

     Hidden over the hero with visibility/opacity, never `display: none`:
     the track *is* the bar's hairline, so removing it from layout would
     collapse the nav's bottom edge. Reversible — scrolling back up drops
     [data-past-hero] and it hides again. */
  .progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background-color: var(--line);
    visibility: hidden;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .nav[data-past-hero] .progress {
    visibility: visible;
    opacity: 1;
  }

  .fill {
    display: block;
    height: 100%;
    background-color: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--scroll-progress, 0));
  }

  @keyframes progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @supports (animation-timeline: scroll()) {
    /* Longhands in their own rules, never the `animation` shorthand: folded
       together the minifier emits `animation: ... scroll(root)` and browsers
       drop the whole declaration (CLAUDE.md §4). The :where(.nav) prefix
       keeps this rule from merging with the one below. */
    :where(.nav) .fill {
      animation-name: progress-grow;
      animation-duration: 1ms; /* Overridden by the timeline. */
      animation-timing-function: linear;
      animation-fill-mode: both;
    }

    /* Range starts at the hero's bottom (one viewport) rather than 0, so the
       fill reads 0% exactly where the bar appears and still reaches 100% at
       the document's end — the same end point as before, only the start
       moved. Its own rule: animation-range folds into the shorthand too. */
    .fill {
      animation-timeline: scroll(root block);
      animation-range: 100dvh 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>
