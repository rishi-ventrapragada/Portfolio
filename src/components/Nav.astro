---
// PRD §5.1 — a fixed bar, transparent over the hero, solid from the moment
// the hero's bottom edge reaches its own. Anchors only: no current-page
// state, no hamburger. Four labels fit phones only by a type step-down
// (SESSION.md, increment 13); a fifth needs a real overflow pattern. The
// progress hairline is NavProgress.astro.
import NavProgress from "./NavProgress.astro";

const links = [
  { label: "Skills", href: "#skills" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="nav" data-nav>
  <nav class="nav-inner" aria-label="Primary">
    {/* `#top` with no matching element scrolls to the document top per the
        HTML spec, so the hero needs no id and there is no reload. */}
    <a class="label mark" href="#top">Rishi</a>
    <ul class="links">
      {
        links.map((link) => (
          <li>
            <a class="label link" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {/* Scroll progress (PRD §5.1), the bar's bottom hairline. */}
  <NavProgress />
</header>

<script>
  // Scroll state and the progress-fill fallback live in scripts/nav.ts
  // (CLAUDE.md §5 cap).
  import { initNav } from "../scripts/nav";

  initNav();
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-height);
    background-color: transparent;
    /* Colours only, never geometry, so the fixed box never moves (§5.1). */
    transition:
      background-color 300ms ease,
      color 300ms ease,
      border-color 300ms ease;
  }

  .nav.is-scrolled {
    background-color: var(--bg-raised);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    /* Gutter keeps the mark and links on the same line as page content rather
       than floating at the very edge. */
    padding-inline: var(--gutter);
  }

  .mark {
    display: block;
    padding-block: 0.5rem;
    color: var(--heading);
  }

  .mark:hover {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .links {
      gap: 2rem;
    }
  }

  .link {
    display: block;
    padding-block: 0.5rem;
    color: var(--fg);
  }

  .link:hover {
    color: var(--accent);
  }

  /* Phone step-down (PRD §5.1): at 375px four 12px / 0.12em labels need
     383px of 327px. Measured, not assumed — see SESSION.md. */
  @media (max-width: 479.98px) {
    .mark,
    .link {
      font-size: var(--size-meta);
      letter-spacing: 0.06em;
    }

    .links {
      gap: 0.75rem;
    }
  }

  /* Narrowest phones (increment 32): at 320px even the step-down was 25px
     too wide — the mark ran into SKILLS and Contact overran the screen by
     1.4px — and up to 357px the two sat under 12px apart. Below 358px the
     gutter, the gaps and the tracking tighten a notch more; measured, the
     mark and the links are then 18.5px apart at 320 and at least 12 at
     every width. */
  @media (max-width: 357.98px) {
    .nav-inner {
      padding-inline: 1rem;
    }

    .mark,
    .link {
      letter-spacing: 0.02em;
    }

    .links {
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: none;
    }
  }
</style>
