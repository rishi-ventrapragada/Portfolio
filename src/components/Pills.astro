---
// Tag pills for a list of strings (PRD §5.3, §5.6). Shared by the tech-stack
// cards and the project card's stack, so the pill exists in exactly one place.
interface Props {
  items: string[];
  /** Secondary emphasis, e.g. "currently learning". */
  muted?: boolean;
  /** Accessible name for the list, e.g. "Stack". */
  label?: string;
}

const { items, muted = false, label } = Astro.props;
---

<ul class="pills" aria-label={label} data-muted={muted ? "" : undefined}>
  {items.map((item) => <li class="pill">{item}</li>)}
</ul>

<style>
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mono like the site's labels, but not uppercased: product names such as
     "Next.js" and "GPT-6 Astra" read wrong shouted. Transparent ground so a
     pill sits equally on --bg and --bg-raised. */
  .pill {
    padding: 0.3rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 2px;
    white-space: nowrap;
  }

  .pills[data-muted] .pill {
    color: var(--fg-muted);
  }
</style>
