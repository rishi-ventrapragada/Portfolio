---
// Tag pills for a list of strings (PRD §5.3): the project detail panel's
// stack. Its own component so the pill exists in exactly one place.
interface Props {
  items: string[];
  /** Accessible name for the list, e.g. "Stack". */
  label?: string;
}

const { items, label } = Astro.props;
---

<ul class="pills" aria-label={label}>
  {items.map((item) => <li class="pill">{item}</li>)}
</ul>

<style>
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mono like the site's labels, but not uppercased: product names such as
     "React 19" and "TypeScript" read wrong shouted. Transparent ground, so a
     pill sits on whatever its frame is (the black film, PRD §5.3). */
  .pill {
    padding: 0.3rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: 2px;
    white-space: nowrap;
  }
</style>
