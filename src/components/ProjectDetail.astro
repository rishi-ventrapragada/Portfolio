---
// The expandable detail of a project frame (PRD §5.3): summary, stack pills
// and full links, laid over the cover. Rendered only when the entry has
// something real to show. On fine-pointer devices it is invisible at rest
// (its links stay in the tab order, so focus can open it) and revealed while
// the frame — `[data-expandable]`, set by ProjectFrame.astro — is hovered or
// has focus within; on no-hover devices it is `display: none`, out of both
// the visual and the accessibility tree, so nothing desktop-only can be
// tapped or tabbed into. Split from ProjectFrame.astro for the line cap.
import Pills from "./Pills.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  summary?: string;
  stack?: string[];
  links?: { live?: string; repo?: string };
}

const { summary, stack, links } = Astro.props;
---

<div class="detail">
  {summary && <p class="summary">{summary}</p>}
  {stack && <Pills items={stack} label="Stack" />}
  <ProjectLinks links={links} variant="full" />
</div>

<style>
  .summary {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--fg);
  }

  @media (hover: hover) and (pointer: fine) {
    .detail {
      position: absolute;
      inset: 0;
      display: grid;
      gap: 0.75rem;
      align-content: end;
      padding: 1rem;
      overflow: auto;
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--bg) 92%, transparent) 70%,
        color-mix(in srgb, var(--bg) 45%, transparent)
      );
      opacity: 0;
      pointer-events: none;
      transition: opacity 160ms ease;
    }

    :global([data-expandable]:hover) .detail,
    :global([data-expandable]:focus-within) .detail {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media not all and (hover: hover) and (pointer: fine) {
    .detail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detail {
      transition: none;
    }
  }
</style>
