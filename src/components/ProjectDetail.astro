---
// The expandable detail of a project frame (PRD §5.3): summary, stack pills
// and full links in a panel that opens *below* the frame, attached to its
// bottom edge and out of grid flow, so the cover stays untouched and no
// sibling moves. Rendered only when the entry has something real to show.
// On fine-pointer devices it is collapsed at rest — a 0fr grid row, so its
// links stay in the tab order and focus can open it — and opens (row 1fr,
// opacity 1) while the frame — `[data-expandable]`, set by
// ProjectFrame.astro — is hovered or has focus within; on no-hover devices
// it is `display: none`, out of both the visual and the accessibility
// tree, so nothing desktop-only can be tapped or tabbed into.
import Pills from "./Pills.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  summary?: string;
  stack?: string[];
  links?: { live?: string; repo?: string };
}

const { summary, stack, links } = Astro.props;
---

<div class="detail">
  <div class="inner">
    {summary && <p class="summary">{summary}</p>}
    {stack && <Pills items={stack} label="Stack" />}
    <ProjectLinks links={links} variant="full" />
  </div>
</div>

<style>
  .inner {
    display: grid;
    gap: 1rem;
  }

  .summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
  }

  /* The height reveal is the grid row going 0fr → 1fr (animatable, no
     fixed height); the inner box clips (not hides: a scroll container
     would shift its content when a link inside is focused) and carries the
     visuals, so at 0fr there is nothing to see. Opacity on the panel keeps
     the shadow and edge from showing while collapsed. */
  @media (hover: hover) and (pointer: fine) {
    .detail {
      position: absolute;
      top: 100%;
      inset-inline: -1px;
      z-index: 3;
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      pointer-events: none;
      transition:
        grid-template-rows 200ms ease,
        opacity 160ms ease;
    }

    .inner {
      min-height: 0;
      overflow: clip;
      background-color: var(--bg-raised);
      border: 1px solid var(--line);
      border-top: 0;
      box-shadow: 0 24px 48px color-mix(in srgb, var(--monitor-bg) 60%, transparent);
    }

    /* Padding inside the clipped box, so the collapsed height is truly 0. */
    .inner > :global(*) {
      margin-inline: 1.25rem;
    }

    .inner > :global(:first-child) {
      margin-top: 1.25rem;
    }

    .inner > :global(:last-child) {
      margin-bottom: 1.25rem;
    }

    :global([data-expandable]:hover) .detail,
    :global([data-expandable]:focus-within) .detail {
      grid-template-rows: 1fr;
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media not all and (hover: hover) and (pointer: fine) {
    .detail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detail {
      transition: none;
    }
  }
</style>
