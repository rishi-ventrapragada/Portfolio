---
// The expandable detail of a project frame (PRD §5.3): summary, stack pills
// and full links in a panel that opens *below* the frame, attached to its
// bottom edge and out of grid flow, so the cover stays untouched and no
// sibling moves. Rendered only when the entry has something real to show.
// On fine-pointer devices it is laid out at full size but invisible at rest
// (opacity 0, no pointer events; its links stay in the tab order so focus
// can open it) and fades in while the frame — `[data-expandable]`, set by
// ProjectFrame.astro — is hovered or has focus within; on no-hover devices
// it is `display: none`, out of both the visual and the accessibility
// tree, so nothing desktop-only can be tapped or tabbed into.
import Pills from "./Pills.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  summary?: string;
  stack?: string[];
  links?: { live?: string; repo?: string };
}

const { summary, stack, links } = Astro.props;
---

<div class="detail">
  <div class="inner">
    <div class="pad">
      {summary && <p class="summary">{summary}</p>}
      {stack && <Pills items={stack} label="Stack" />}
      <ProjectLinks links={links} variant="full" />
    </div>
  </div>
</div>

<style>
  .pad {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg);
  }

  /* Opacity reveal over a panel that is always laid out at full height.
     A height animation was tried (increment 15.1): when a keyboard user
     Tabs into a collapsed panel the browser scrolls the link into view
     *before* the height grows, and the link ends up below the fold. With a
     stable box, focus scrolls straight to the right place. */
  @media (hover: hover) and (pointer: fine) {
    .detail {
      position: absolute;
      top: 100%;
      inset-inline: -1px;
      z-index: 3;
      opacity: 0;
      pointer-events: none;
      transition: opacity 160ms ease;
    }

    .inner {
      background-color: var(--bg-raised);
      border: 1px solid var(--line);
      border-top: 0;
      box-shadow: 0 24px 48px var(--shadow);
    }

    :global([data-expandable]:hover) .detail,
    :global([data-expandable]:focus-within) .detail {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media not all and (hover: hover) and (pointer: fine) {
    .detail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detail {
      transition: none;
    }
  }
</style>
