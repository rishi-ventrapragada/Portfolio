---
// One film frame of the Projects contact sheet (PRD §5.3): sprocket strips
// top and bottom, the cover, then a caption of title and frame number, then
// the detail (summary, stack, links — ProjectDetail.astro). With one real
// project the detail is simply shown (`open`, increment 29); with more, on
// fine pointers it opens below the frame on hover / focus and the frame
// lifts, and elsewhere quick links sit under the caption. `status` is never
// printed; a planned entry takes `.planned` and has no detail. No script.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import ProjectDetail from "./ProjectDetail.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  entry: CollectionEntry<"projects">;
  /** Position in the sheet, for the frame number. */
  index: number;
  /** Show the detail in place, on every device, instead of on hover
   * (ProjectsSection.astro decides: one real project). */
  open?: boolean;
}

const { entry, index, open = false } = Astro.props;
const { title, summary, stack, status, links, cover } = entry.data;
const planned = status === "planned";
const number = `Frame ${String(index + 1).padStart(3, "0")}`;
// Anything real to reveal? A planned entry has none of these by schema.
const hasDetail = !!(summary || stack || links);
const expandable = hasDetail && !open;
const shown = hasDetail && open;
---

<article class:list={["frame", { planned }]} data-expandable={expandable ? "" : undefined}>
  <div class="cover">
    {/* The cover is a screenshot, so it sets its own ratio rather than
        being cropped. */}
    <Image
      src={cover}
      alt={`${title} project cover`}
      widths={[636, 1272]}
      sizes="(min-width: 768px) 600px, 92vw"
      loading="lazy"
      decoding="async"
    />
  </div>

  {/* h3: the section owns the h2 and the hero owns the page's only h1.
      No year tag (increment 15.1): the caption is title and frame number. */}
  <div class="caption">
    <h3 class="title">{title}</h3>
    <p class="meta number">{number}</p>
  </div>

  {
    !shown && (
      <div class="quick">
        <ProjectLinks links={links} variant="quick" />
      </div>
    )
  }

  {/* Hover mode: absolutely positioned under the frame's bottom edge, so it
      never takes grid space. Open mode: in the frame, in flow. */}
  {hasDetail && <ProjectDetail summary={summary} stack={stack} links={links} open={shown} />}
</article>

<style>
  /* Layered so the shared, unlayered `.planned` utility (utilities.css)
     wins its border-style without !important; `.frame.planned` below then
     replaces the utility's fade. */
  @layer components {
    .frame {
      position: relative;
      display: grid;
      gap: 0.5rem;
      align-content: start;
      background-color: var(--bg-raised);
      border: 1px solid var(--line);
      border-radius: 2px;
    }
  }

  /* Light scope (increment 24): the frame is black film lying on the paper
     page — the page, its gutters and heading stay light. Existing tokens
     re-pointed on the frame only, so the caption, the quick links and the
     hover panel (all inside it) follow. The perforations punch through to
     the paper, as real film does; kept #111214 they measured 1.1:1 on the
     black. Ratios on --monitor-bg: ink 18.93, muted 7.18. --line is a
     decorative edge, not text. */
  :global([data-theme="light"]) .frame {
    --bg-raised: var(--monitor-bg);
    --heading: var(--light-bg);
    --fg: var(--light-bg);
    --fg-muted: color-mix(in srgb, var(--light-bg) 62%, var(--monitor-bg));
    --line: color-mix(in srgb, var(--light-bg) 18%, var(--monitor-bg));
    --sprocket-hole: var(--light-bg);
  }

  /* The light-scope accent is darkened for paper and fails on black
     (3.49). --accent cannot be mixed into itself, so its two uses in here
     are lifted at the use site instead: 5.41. */
  :global([data-theme="light"]) .frame :global(.link:hover) {
    color: color-mix(in srgb, var(--accent) 70%, var(--light-bg));
    border-bottom-color: color-mix(in srgb, var(--accent) 70%, var(--light-bg));
  }

  :global([data-theme="light"]) .frame :global(:focus-visible) {
    outline-color: color-mix(in srgb, var(--accent) 70%, var(--light-bg));
  }

  /* Planned (Recurzn): only the cover steps back. The shared utility's 0.5
     opacity on the whole article took the title to 3.90:1 and the frame
     number to 2.50:1 on the paper (increment 28); dimming the picture alone
     keeps the "not shipped yet" read while every word stays at the frame's
     full contrast. The dashed edge still comes from the utility. */
  .frame.planned {
    opacity: 1;
  }

  .frame.planned .cover {
    opacity: 0.5;
  }

  /* Sprocket strips: whole holes only. `space` lays complete 16px tiles
     across the width and spreads the remainder between them, so the last
     hole is never clipped at the frame's edge at any width. */
  .frame::before,
  .frame::after {
    content: "";
    display: block;
    height: 14px;
    background-image: radial-gradient(circle, var(--sprocket-hole) 0 3px, transparent 3.5px);
    background-size: 16px 100%;
    background-repeat: space no-repeat;
  }

  .cover {
    position: relative;
    margin-inline: 0.75rem;
    overflow: hidden;
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.25rem 0.75rem;
  }

  .title {
    margin: 0;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
  }

  .number {
    flex: none;
    margin: 0;
  }

  .quick {
    padding: 0 0.75rem 0.5rem;
  }

  /* Hover / focus expand, only where a hover exists: the frame lifts a
     little (transform only, so siblings never move) and its panel opens
     below it (ProjectDetail.astro). The panel is the main event, so the
     scale stays modest. z-index puts the open panel over the next row. */
  @media (hover: hover) and (pointer: fine) {
    .quick {
      display: none;
    }

    .frame[data-expandable] {
      transition:
        transform 200ms ease,
        box-shadow 200ms ease;
    }

    .frame[data-expandable]:hover,
    .frame[data-expandable]:focus-within {
      z-index: 2;
      transform: scale(1.02);
      box-shadow: 0 24px 48px var(--shadow);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame[data-expandable] {
      transition: none;
    }
  }
</style>
