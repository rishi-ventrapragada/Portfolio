---
// The Contact backdrop since increment 29 (PRD §5.15): the projector beam.
// The site ends on its credits, so the ground behind them is the light they
// are projected by — a soft cone from a source above the top edge, widening
// down the pin, with a little dust rising through it. Replaced the
// topographic contours, which read as noise (the owner's pick of two
// screenshotted options; the other was the contours denoised). Tokens only:
// the light is --heading at a few percent over --bg. Mounted inside the
// credits pin (Footer.astro), so it stays put for the whole scroll.
---

<div class="beam" aria-hidden="true" data-offscreen-pause>
  <div class="cone"></div>
  <div class="dust"><div class="motes"></div></div>
</div>

<style>
  /* contain: strict — decorative and fixed-size, so it never affects
     layout and the browser can skip it off-screen. The dust pauses there
     too (data-offscreen-pause). */
  .beam {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    contain: strict;
    pointer-events: none;
    background-color: var(--bg);
  }

  /* One cone, clipped to a trapezoid; brightest at the source, fading out
     well before the bottom, where the © line and cards sit. */
  .cone,
  .dust {
    position: absolute;
    inset: 0;
    clip-path: polygon(44% 0, 56% 0, 96% 100%, 4% 100%);
  }

  .cone {
    background:
      radial-gradient(ellipse 30% 22% at 50% 0%, color-mix(in srgb, var(--heading) 10%, transparent), transparent),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--heading) 7%, transparent),
        color-mix(in srgb, var(--heading) 3%, transparent) 55%,
        transparent 95%
      );
  }

  /* Dust: three dot grids on different periods read as scattered motes.
     The layer rises 240px per loop — a whole number of each grid's vertical
     period (80, 60, 120) — and is 240px taller than the pin, so the wrap is
     seamless. Transform only, ~6px/s. */
  .motes {
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(100% + 240px);
    background:
      radial-gradient(circle, color-mix(in srgb, var(--heading) 35%, transparent) 0 1px, transparent 1.5px) 0 0 / 97px 80px,
      radial-gradient(circle, color-mix(in srgb, var(--heading) 22%, transparent) 0 0.8px, transparent 1.3px) 31px 17px / 61px 60px,
      radial-gradient(circle, color-mix(in srgb, var(--heading) 28%, transparent) 0 1.2px, transparent 1.7px) 53px 41px / 139px 120px;
    animation: rise 40s linear infinite;
  }

  @keyframes rise {
    to {
      transform: translateY(-240px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motes {
      animation: none;
    }
  }
</style>
