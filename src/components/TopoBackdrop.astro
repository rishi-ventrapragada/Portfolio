---
// Topographic contour backdrop for the Contact section (PRD §5.15).
//
// Generated here, not downloaded — the same feTurbulence technique the boot
// preloader uses for its pixel noise (§5.10), retuned from grain to elevation
// lines. Three things do that:
//
//   1. A very low baseFrequency with five octaves makes large, smooth,
//      wandering shapes instead of fine noise — an elevation surface.
//   2. feColorMatrix collapses the three channels to one luminance value and
//      sets the RGB to the line colour. Turbulence generates each channel
//      independently, so without the collapse the contours fringe green and
//      magenta (the §5.10 lesson); without the tint they paint pure white,
//      which measured 3.13:1 behind the contact links — below AA.
//   3. The discrete alpha ramp is mostly 0 with a single 1 every fourteenth
//      step. A narrow band across a smooth surface is exactly the definition
//      of an iso-line, so the result is thin closed contour rings rather than
//      the filled blobs a wider band gives.
//
// A fixed seed keeps it identical across builds. Fully static: no animation,
// so prefers-reduced-motion has nothing to change here.
const contour =
  "%3Csvg xmlns='http://www.w3.org/2000/svg' width='1200' height='800'%3E" +
  "%3Cfilter id='t' color-interpolation-filters='sRGB'%3E" +
  "%3CfeTurbulence type='fractalNoise' baseFrequency='0.011' numOctaves='5' seed='11' stitchTiles='stitch'/%3E" +
  // RGB fixed to --fg-muted (#9a9ca3 = .604 .612 .639); alpha is the collapsed
  // luminance, which the ramp below then slices into iso-lines.
  "%3CfeColorMatrix type='matrix' values='0 0 0 0 0.604 0 0 0 0 0.612 0 0 0 0 0.639 0.34 0.34 0.34 0 0'/%3E" +
  "%3CfeComponentTransfer%3E%3CfeFuncA type='discrete' tableValues='" +
  Array.from({ length: 84 }, (_, i) => (i % 14 === 0 ? 1 : 0)).join(" ") +
  "'/%3E%3C/feComponentTransfer%3E%3C/filter%3E" +
  "%3Crect width='1200' height='800' filter='url(%23t)'/%3E%3C/svg%3E";
---

<div class="topo" aria-hidden="true" style={`--contour: url("data:image/svg+xml,${contour}")`}></div>

<style>
  /* contain: strict — decorative and fixed-size, so it never affects layout
     and the browser can skip it when the section is off-screen. */
  .topo {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    contain: strict;
    pointer-events: none;
    background-color: var(--bg);
    background-image: var(--contour);
    background-size: 1200px 800px;
    /* Low enough that the contours sit under the credits rather than
       competing with them. The figure that matters is the contrast of the
       stage text against a contour line passing directly behind it, sampled
       from rendered pixels rather than assumed — see the PRD for the
       measurement. */
    opacity: 0.42;
  }
</style>
