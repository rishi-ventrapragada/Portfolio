---
import { Font } from "astro:assets";
import "../styles/global.css";
// After global.css on purpose: the section-scoped light tokens have to win
// over :root[data-accent=...] on order, since they cannot on specificity.
import "../styles/theme-light.css";
import Footer from "../components/Footer.astro";
import AccentToggle from "../components/AccentToggle.astro";
import BootPreloader from "../components/BootPreloader.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Every absolute URL below derives from this one value, so changing `site`
// in astro.config.mjs updates canonical, og:url and twitter:url together.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en" data-accent="crimson">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Critical paint styles, inline and first: global.css is bundled into an
        external stylesheet, so until that request resolves the document has no
        background and the browser paints white — a bright flash on every hard
        reload before the dark theme lands. These few declarations give the
        first paint the right canvas. Values are duplicated from the tokens in
        global.css by necessity (nothing else is parsed yet) and must be kept
        in step with them. */}
    <style is:inline>
      :root {
        color-scheme: dark;
        background-color: #111214;
      }
      html,
      body {
        margin: 0;
        background-color: #111214;
      }
      /* The preloader overlay covers the hero from the first paint, so the
         hero must never be visible behind it even before global.css lands. */
      .boot {
        position: fixed;
        inset: 0;
        z-index: 200;
        background-color: #111214;
      }
    </style>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111214" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <Font cssVariable="--font-display-src" preload />
    <Font cssVariable="--font-mono-src" />

    {/* Set the accent before first paint so the toggle never flashes. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem("accent");
        if (saved === "violet" || saved === "crimson") {
          document.documentElement.dataset.accent = saved;
        }
      } catch {
        /* localStorage unavailable — keep the crimson default. */
      }
    </script>
  </head>
  {/* tabindex="-1" so the preloader can move focus here on removal. */}
  <body tabindex="-1">
    <BootPreloader />
    <a class="skip-link label" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <AccentToggle />}
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background-color: var(--bg-raised);
    color: var(--fg);
    transform: translateY(-120%);
    transition: transform 160ms ease;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* body is only focusable as a script target, never as a visible focus ring. */
  body:focus {
    outline: none;
  }
</style>
