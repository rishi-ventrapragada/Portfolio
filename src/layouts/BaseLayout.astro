---
import { Font } from "astro:assets";
import "../styles/global.css";
import "../styles/utilities.css";
// After global.css on purpose: [data-theme="light"] and :root are both
// (0,1,0), so the section-scoped light tokens win on order.
import "../styles/theme-light.css";
import Footer from "../components/Footer.astro";
import BootPreloader from "../components/BootPreloader.astro";
import Nav from "../components/Nav.astro";
import StarfieldDefs from "../components/StarfieldDefs.astro";

interface Props {
  title: string;
  description: string;
  /** A page outside the one-page site (increment 32: the 404): no boot
   * overlay, nav or credits — their anchors only exist on the home page —
   * no canonical, and kept out of search results. */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
// Every absolute URL below derives from this one value, so changing `site`
// in astro.config.mjs updates canonical, og:url, twitter:url and the share
// image together.
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
// public/og.png: 1200×630, generated once from the site's own assets (the
// wordmark's outlines, the hero cutout, the star data) — recipe in
// SESSION.md, increment 32.
const ogImage = new URL("/og.png", site).href;
const ogAlt = "RISHI in large letters behind a photo of Sai Rishi Ventrapragada, on a dark starry ground";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* A page's earliest requests (increment 32: the hero's preload), ahead
        of everything else in the head so the fetch starts with the first
        bytes of the document. */}
    <slot name="head" />

    {/* Critical paint styles, inline and first: global.css is bundled into an
        external stylesheet, so until that request resolves the document has no
        background and the browser paints white — a bright flash on every hard
        reload before the dark theme lands. These few declarations give the
        first paint the right canvas. Values are duplicated from the tokens in
        global.css by necessity (nothing else is parsed yet) and must be kept
        in step with them. */}
    <style is:inline>
      :root {
        color-scheme: dark;
        background-color: #0b0b0d;
      }
      html,
      body {
        margin: 0;
        background-color: #0b0b0d;
      }
      /* The preloader overlay covers the hero from the first paint, so the
         hero must never be visible behind it even before global.css lands. */
      .boot {
        position: fixed;
        inset: 0;
        z-index: 200;
        background-color: #0b0b0d;
      }
    </style>

    {/* The favicon set (increment 32): the SVG, PNGs for browsers that
        want a raster, and the home-screen icon for iOS. One source,
        generated once — ASSETS.md. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {bare ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0d" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <Font cssVariable="--font-display-src" preload />
    <Font cssVariable="--font-mono-src" />
  </head>
  {/* tabindex="-1" so the preloader can move focus here on removal. */}
  <body tabindex="-1">
    {!bare && <BootPreloader />}
    {
      !bare && (
        <a class="skip-link label" href="#main">
          Skip to content
        </a>
      )
    }
    {/* Without JavaScript nothing ever makes the nav solid, and a
        transparent bar leaves its white links on the light About and
        Projects sections at 1.1:1. So without JS the bar is solid
        everywhere (Nav.astro's own <style> is scoped, hence here). */}
    <noscript><style>[data-nav] { background-color: var(--bg-raised) !important; }</style></noscript>
    {!bare && <Nav />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {/* The star lists every sky paints (increment 32: moved from the
        <head>, where 43 KB of them sat in front of everything the page
        requests). Still parsed before the first paint, which waits on the
        render-blocking stylesheet — measured, the boot overlay's first
        painted frame has its stars on a hard reload and on slow 4G. */}
    <StarfieldDefs />
  </body>
</html>

<script>
  import { initOffscreenPause } from "../scripts/offscreen-pause";

  initOffscreenPause();
</script>

<style>
  /* Decorative loops pause while out of view (scripts/offscreen-pause.ts).
     !important is load-bearing, not a shortcut: every paused element runs
     its loop from a component's own scoped `animation` shorthand, and that
     shorthand resets animation-play-state to `running` at a higher
     specificity (a scoped class plus attributes) than this generic,
     component-agnostic rule can ever have. Only an important declaration
     outranks every one of them without restating each selector here. */
  :global([data-offscreen]),
  :global([data-offscreen] *) {
    animation-play-state: paused !important;
  }

  .skip-link {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background-color: var(--bg-raised);
    color: var(--fg);
    transform: translateY(-120%);
    transition: transform 160ms ease;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* No slide under reduced motion: the link is simply there on focus. */
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }

  /* body is only focusable as a script target, never as a visible focus ring. */
  body:focus {
    outline: none;
  }
</style>
